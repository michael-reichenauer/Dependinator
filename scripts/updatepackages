#!/bin/bash
# List (and with -u/-m upgrade) outdated NuGet and npm packages, and check for
# vulnerable ones — covers the .NET solution, the VS Code extension and the TypeScript
# parser's helper.
#
#   ./scripts/updatepackages       list outdated + vulnerable packages
#   ./scripts/updatepackages -u    upgrade non-major versions
#   ./scripts/updatepackages -m    upgrade all versions, including major
cd "$(dirname "$0")/.."

# Function to check if dotnet-outdated is installed
check_dotnet_outdated_installed() {
    if ! dotnet tool list -g | grep -q 'dotnet-outdated'; then
        echo "dotnet-outdated is not installed. Installing it now..."
        dotnet tool install --global dotnet-outdated-tool
    fi
}

# Initialize variables
update_packages=false
include_major=false

# Parse command-line arguments
while getopts "um" opt; do
    case $opt in
        u)
            update_packages=true
            ;;
        m)
            update_packages=true
            include_major=true
            ;;
        *)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

# Directory holding the TypeScript VS Code extension
vscode_ext_dir="$PWD/src/DependinatorVsCode"

# Directory holding the TypeScript parser's Node.js helper (bundled into Dependinator.TypeScript)
ts_helper_dir="$PWD/src/Dependinator.TypeScript/Helper"

# Check if dotnet-outdated is installed
check_dotnet_outdated_installed

# ---------------------------------------------------------------------------------
# .NET packages
# ---------------------------------------------------------------------------------
if [ "$update_packages" = true ]; then
    if [ "$include_major" = true ]; then
        echo "Upgrading all packages (including major) in '$PWD' ..."
        dotnet outdated "$projectFile" --upgrade
    else
        echo "Upgrading all non-major packages in '$PWD' ..."
        dotnet outdated "$projectFile" --upgrade --version-lock Major
    fi
fi

echo
echo "================================================================================="
echo "Listing all outdated packages in $PWD"
dotnet outdated
echo
echo "================================================================================="
echo "Checking for vulnerable packages in $PWD"
dotnet list package --vulnerable

# ---------------------------------------------------------------------------------
# npm packages (VS Code extension)
# ---------------------------------------------------------------------------------
if [ -f "$vscode_ext_dir/package.json" ]; then
    echo
    echo "================================================================================="
    echo "npm packages of the VS Code extension in $vscode_ext_dir"

    if [ "$update_packages" = true ]; then
        if [ "$include_major" = true ]; then
            echo "Upgrading all npm packages (including major) ..."
            # npm-check-updates rewrites package.json ranges to the latest versions
            (cd "$vscode_ext_dir" && npx --yes npm-check-updates -u && npm install)
        else
            echo "Upgrading all non-major npm packages (within semver ranges) ..."
            (cd "$vscode_ext_dir" && npm update)
        fi
    fi

    echo
    echo "Listing all outdated npm packages"
    (cd "$vscode_ext_dir" && npm outdated)
    echo
    echo "Checking for vulnerable npm packages"
    (cd "$vscode_ext_dir" && npm audit)
fi

# ---------------------------------------------------------------------------------
# npm packages (TypeScript parser helper)
# ---------------------------------------------------------------------------------
# typescript is pinned to an exact version there, which "npm update" never moves, so
# npm-check-updates rewrites it. It stays on its major version even with -m: TypeScript 7 is
# the native compiler, without the API the helper uses (docs/notes/TYPESCRIPT-PARSER.md).
if [ -f "$ts_helper_dir/package.json" ]; then
    echo
    echo "================================================================================="
    echo "npm packages of the TypeScript parser helper in $ts_helper_dir"

    if [ "$update_packages" = true ]; then
        if [ "$include_major" = true ]; then
            echo "Upgrading all npm packages (including major, but typescript only within its major) ..."
            (cd "$ts_helper_dir" \
                && npx --yes npm-check-updates -u --reject typescript \
                && npx --yes npm-check-updates -u --target minor --filter typescript \
                && npm install)
        else
            echo "Upgrading all non-major npm packages (within semver ranges, typescript within its major) ..."
            (cd "$ts_helper_dir" \
                && npx --yes npm-check-updates -u --target minor --filter typescript \
                && npm install \
                && npm update)
        fi
    fi

    echo
    echo "Listing all outdated npm packages"
    (cd "$ts_helper_dir" && npm outdated)
    echo
    echo "Checking for vulnerable npm packages"
    (cd "$ts_helper_dir" && npm audit)
fi

echo
echo "---------------------------------------------------------------------------------"
echo "Use option '-u' to update non-major outdated packages"
echo "Use option '-m' to update all outdated packages including major versions"
echo