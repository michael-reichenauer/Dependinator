#!/usr/bin/env python3
"""Print the failed tests of trx result files as Markdown, for a GitHub job summary.

  ./scripts/test-summary <title> <file.trx>... [--rerun <rerun.trx>]

Each failed test is listed with the first lines of its error message. With --rerun (the traced
re-run of the failed e2e tests, ./scripts/e2e -r), each test also says whether it passed then
(flaky) or failed again. Prints nothing when no test failed.
"""
import sys
import xml.etree.ElementTree as ET

MAX_MESSAGE_LINES = 6


def local(tag):
    return tag.rsplit("}", 1)[-1]


def results(path):
    """Yields (test name, outcome, error message) for each result in a trx file."""
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return
    for element in root.iter():
        if local(element.tag) != "UnitTestResult":
            continue
        message = next((e.text or "" for e in element.iter() if local(e.tag) == "Message"), "")
        # A theory's arguments are cut off, as in ./scripts/e2e, so its cases share one name.
        yield element.get("testName", "?").split("(")[0], element.get("outcome", ""), message


def main():
    args = sys.argv[1:]
    rerun_path = None
    if "--rerun" in args:
        i = args.index("--rerun")
        rerun_path = args[i + 1] if i + 1 < len(args) else None
        args = args[:i]
    if not args:
        sys.exit(__doc__)
    title, paths = args[0], args[1:]

    failed = {}
    for path in paths:
        for name, outcome, message in results(path):
            if outcome == "Failed":
                failed.setdefault(name, message)
    if not failed:
        return

    rerun = {}
    if rerun_path:
        for name, outcome, _ in results(rerun_path):
            # Failed wins when a theory's cases differ.
            if rerun.get(name) != "Failed":
                rerun[name] = outcome

    print(f"### {title}: {len(failed)} failed test{'' if len(failed) == 1 else 's'}\n")
    for name, message in sorted(failed.items()):
        note = ""
        if rerun_path:
            note = {
                "Passed": " — passed on the re-run (flaky)",
                "Failed": " — failed again on the re-run",
            }.get(rerun.get(name), " — not re-run")
        print(f"- `{name}`{note}")
        lines = [line.rstrip() for line in message.strip().splitlines() if line.strip()]
        if lines:
            print("\n  ```")
            for line in lines[:MAX_MESSAGE_LINES]:
                # A fence inside the message would end the code block early.
                print("  " + line[:300].replace("```", "'''"))
            print("  ```")
    print()


if __name__ == "__main__":
    main()
