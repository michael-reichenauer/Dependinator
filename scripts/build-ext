#!/bin/bash
# Build the VS Code extension: npm install, bump the patch version, and
# package it into a .vsix (see src/Dependinator.VsCodeExt/).
cd "$(dirname "$0")/.."
npm install --prefix ./src/Dependinator.VsCodeExt
npm version patch --no-git-tag-version --prefix ./src/Dependinator.VsCodeExt
npm run package --prefix ./src/Dependinator.VsCodeExt
