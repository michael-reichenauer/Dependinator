{
    // Its own path alias, which the server part does not have
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "composite": true,
        "types": [],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}
