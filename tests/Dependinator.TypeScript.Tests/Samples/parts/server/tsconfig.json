{
    // No "types": the installed @types packages (Node's) are included, as before TypeScript 6.
    // No "references" either: that libs/util is a part is known from the solution's config.
    // The catch-all path is more places to look for any module, and an alias only for what is
    // in one of them ("shapes/…").
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "composite": true,
        "paths": {
            "*": ["./types/*", "../node_modules/*"]
        }
    },
    "include": ["src"]
}
