<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Dependinator.Claude</AssemblyName>
        <RootNamespace>Dependinator.Claude</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Anthropic" />
        <!-- The MCP client, for the model tools the host serves (ModelToolsAgent). -->
        <PackageReference Include="ModelContextProtocol.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Dependinator.Core/Dependinator.Core.csproj" />
    </ItemGroup>
</Project>
