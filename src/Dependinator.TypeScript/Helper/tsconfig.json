{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "src",
        "strict": true,
        "noEmit": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src"]
}
