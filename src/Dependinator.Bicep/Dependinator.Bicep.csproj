<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Dependinator.Bicep</AssemblyName>
        <RootNamespace>Dependinator.Bicep</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Bicep.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Dependinator.Core/Dependinator.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pre-parsed demo deployment (shared with the Wasm host's wwwroot, generated by
             ./scripts/gen-demo bicep from examples/bicep), embedded so the Web/LSP hosts can load
             "/Demo.bicep" without the compiler. See BicepParser. Conditional only so the generator
             itself builds before the file exists the first time. -->
        <EmbeddedResource
            Include="../Dependinator.Wasm/wwwroot/demo-bicep.model"
            LogicalName="Dependinator.Bicep.demo-bicep.model"
            Condition="Exists('../Dependinator.Wasm/wwwroot/demo-bicep.model')"
        />
    </ItemGroup>
</Project>
