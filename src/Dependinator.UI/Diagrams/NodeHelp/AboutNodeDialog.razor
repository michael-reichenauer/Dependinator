@using Dependinator.UI.Diagrams.Ai
@using MudBlazor
@inject IClipboardService clipboardService

@* About a node (AboutNodeService): what the model knows of it (its comment, what it contains, how
   many types outside it it uses and are used by it), and questions about it for an AI. Where the
   host can ask an AI, the example questions (AskExamples) and "Ask another question" close the
   dialog for the Ask panel, which asks about the node, with follow-ups and links. In the
   standalone browser app, which cannot ask, the question ("What is this and why is it here?"
   until the user writes another) is for the user's own AI chat: copy the prompt, paste the answer
   (AiOpinion). "Improve comments" closes it for the Improve comments dialog (ImproveCommentsService). *@
<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">About @Facts.Kind</MudText>
  </TitleContent>
  <DialogContent>
    <div class="dep-cycles__dialog-cycle" data-testid="about-node-name">
      <span class="dep-cycles__container">@Facts.LongName</span>
    </div>
    @if (Facts.Description is { } description)
    {
      <div class="dep-about__comment" data-testid="about-node-comment">@description</div>
    }
    else
    {
      <div class="dep-about__comment dep-about__comment--none" data-testid="about-node-comment">
        No comment in the code.
      </div>
    }
    <div class="dep-about__facts" data-testid="about-node-facts">
      @Facts.Contents · uses @TypesText(Facts.UsesCount) · used by @TypesText(Facts.UsedByCount)
    </div>
    @if (IsAskInPanel)
    {
      <div class="dep-about__ask" data-testid="about-node-ask">
        <div class="dep-about__ask-title">Ask AI about it</div>
        <div class="dep-ask__examples">
          @foreach (var example in Examples)
          {
            <button type="button" class="dep-ask__example" @onclick="() => AskInPanel(example)"
                    data-testid="about-node-example">@example</button>
          }
        </div>
        <MudButton Class="dep-ai-ask mt-2" Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@MudBlazor.Icons.Material.Outlined.QuestionAnswer" OnClick="@(() => AskInPanel(""))"
                   title="Open the Ask panel to ask your own question about this node"
                   data-testid="about-node-ask-other">Ask another question …</MudButton>
      </div>
    }
    else
    {
    <MudTextField T="string" @bind-Value="Question" Label="Your question" Immediate="true" Class="mt-3 mb-1"
                  data-testid="about-node-question" />
    <AiOpinion TAnswer="NodeAnswer" TestId="about-node" GetPrompt="PromptAsync" Ask="AskOrNull"
               ParsePasted="ParsePasted" IsExpandedAtStart="true" ExpandText="Ask AI about it"
               AnswerTitle="AI answer"
               RouteText="Claude reads the node, its links and its code and answers here."
               AskTitle="Ask Claude the question about this node"
               CopyTitle="Copy a prompt with the question, the node, its links and its code"
               PromptCopiedText="The prompt is copied, with the question, the node, its links and its code.">
      <AnswerContent Context="a">
        <div class="dep-ai__suggestion" data-testid="about-node-answer">
          <div class="dep-ai__suggestion-verdict">@($"{a.Source.Name()} answers")</div>
          @if (a.Question != "")
          {
            <div class="dep-ai__suggestion-note" data-testid="about-node-answered-question">@a.Question</div>
          }
          <div class="dep-ai__markdown">@((MarkupString)SimpleMarkdown.ToHtml(a.Text))</div>
          <div>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@MudBlazor.Icons.Material.Outlined.ContentCopy"
                       OnClick="() => CopyAnswerAsync(a)" data-testid="about-node-copy-answer">Copy answer</MudButton>
            @if (copyNote is not null)
            {
              <span class="dep-ai__suggest-note" data-testid="about-node-copied">@copyNote</span>
            }
          </div>
        </div>
      </AnswerContent>
    </AiOpinion>
    }
  </DialogContent>
  <DialogActions>
    @if (CanImproveComments)
    {
      <MudButton Variant="Variant.Text" StartIcon="@MudBlazor.Icons.Material.Outlined.EditNote" OnClick="ImproveComments"
                 title="Have Claude Code add or rewrite the comments of this node, or of everything inside it"
                 data-testid="about-node-improve-comments">Improve comments …</MudButton>
    }
    <MudSpacer />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close" data-testid="about-node-close">Close</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter, EditorRequired] public NodeFacts Facts { get; set; } = null!;

  // The prompt that asks any AI the question, to copy or show.
  [Parameter, EditorRequired] public Func<string, Task<string>> GetPrompt { get; set; } = null!;

  // Asks Claude (or Claude Code) the question, telling each step; null where the host cannot ask.
  [Parameter] public Func<string, AiSource, Action<SuggestStep>, Task<Result<NodeAnswer>>>? Ask { get; set; }

  // The host can ask an AI: questions go to the Ask panel, which the service opens once this
  // dialog is closed with the question as its result ("" for the user's own).
  [Parameter] public bool IsAskInPanel { get; set; }

  static readonly IReadOnlyList<string> Examples = [.. Dependinator.UI.Diagrams.Ask.AskExamples.For(1).SelectMany(g => g.Top)];

  void AskInPanel(string question) => MudDialog.Close(DialogResult.Ok(new AskInPanelResult(question)));

  public record AskInPanelResult(string Question);

  // The node, or something inside it, has a comment the parser reads.
  [Parameter] public bool CanImproveComments { get; set; }

  string Question { get; set; } = NodePrompt.DefaultQuestion;
  string? copyNote;

  Func<AiSource, Action<SuggestStep>, Task<Result<NodeAnswer>>>? AskOrNull =>
    Ask is null ? null : (route, onStep) => Ask(QuestionText, route, onStep);

  string QuestionText => string.IsNullOrWhiteSpace(Question) ? NodePrompt.DefaultQuestion : Question.Trim();

  Task<string> PromptAsync() => GetPrompt(QuestionText);

  // A pasted answer answers the question in the field, which the copied prompt asked.
  Result<NodeAnswer> ParsePasted(string text)
  {
    var parsed = NodeAnswer.ParseText(text);
    return parsed is NodeAnswer answer ? answer with { Question = QuestionText } : parsed.Error;
  }

  static string TypesText(int count) => count == 1 ? "1 type" : $"{count} types";

  async Task CopyAnswerAsync(NodeAnswer answer)
  {
    copyNote = await clipboardService.CopyAsync(answer.Text) ? "Copied." : "Could not copy to the clipboard.";
  }

  void Close() => MudDialog.Close();

  // The service opens the Improve comments dialog once this one is closed.
  void ImproveComments() => MudDialog.Close(DialogResult.Ok(ImproveCommentsResult));

  public const string ImproveCommentsResult = "improve-comments";
}
