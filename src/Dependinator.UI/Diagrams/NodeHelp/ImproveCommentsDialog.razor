@using Dependinator.UI.Diagrams.Ai
@using MudBlazor
@inject IClipboardService clipboardService
@inject IDialogService dialogService
@inject IAiService aiService

@* Improve Comments (ImproveCommentsService): an AI that can change the code adds or rewrites the
   comments of a node's namespaces and types and the descriptions of its projects, or of everything inside it, which the diagram shows as
   their descriptions. The scope shows how many that is and in how many files, with a warning when
   one run may not finish in time. Under it, the AI section looks like the review dialogs' (AiOpinion):
   one button for the AI that does it, the provider menu beside it (AiProviderMenu, with "Copy prompt"
   added) and "Show prompt". Claude Code and Copilot change code: "Improve with Claude Code"
   (ClaudeCodeFix, where the experimental route is on) runs here, on the code as it is, on the current
   branch; "Improve with Copilot" (in VS Code) hands the prompt to Copilot Chat in agent mode, which
   makes the change in its own view. The default of the two is the button where it can run; otherwise
   "Copy prompt" is, for any AI that can change the code. The dialog's own row only closes it: Close,
   or Done once Claude Code changed files. *@
<MudDialog ActionsClass="dep-ai__actions">
  <TitleContent>
    <MudText Typo="Typo.h6">Improve comments</MudText>
  </TitleContent>
  <DialogContent>
    <div class="dep-about__text">
      An AI adds or rewrites the comments of namespaces and types, and the descriptions of projects (their
      AssemblyDescription attribute), which the diagram shows as their descriptions. It reads the code and the
      dependencies first, and changes comments and descriptions only.
    </div>
    @if (HasChildren)
    {
      <MudRadioGroup T="bool" Value="isBelow" ValueChanged="SetBelow" Disabled="@IsLocked" Class="mt-2"
                     data-testid="improve-comments-scope">
        <MudRadio T="bool" Value="false" Dense="true" data-testid="improve-comments-only">
          @(IsSeveral ? "Only the selected nodes" : $"Only {Name}")
        </MudRadio>
        <MudRadio T="bool" Value="true" Dense="true" data-testid="improve-comments-below">
          @(IsSeveral ? "The selected nodes and everything inside them" : $"{Name} and everything inside it")
        </MudRadio>
      </MudRadioGroup>
    }
    else
    {
      <div class="dep-cycles__dialog-cycle mt-2"><span class="dep-cycles__container">@Name</span></div>
    }
    <div class="dep-about__facts" data-testid="improve-comments-count">@CountText</div>
    @if (scope.Targets > CommentsPrompt.ManyTargets)
    {
      <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="improve-comments-many">
        That is a lot for one run: the AI may not finish in time. A smaller part, a namespace say, works better.
      </MudAlert>
    }
    @if (!IsDone)
    {
      <div class="dep-ai__header dep-ai" data-testid="improve-comments-ai">
        <span class="dep-ai__ask-split">
          @if (Runner?.Source is AiSource.ClaudeCode)
          {
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="dep-ai-ask" StartIcon="@MudBlazor.Icons.Material.Outlined.AutoFixHigh"
                       Disabled="@(IsEmpty || IsLocked)" OnClick="() => fixPanel!.StartAsync()"
                       title="Claude Code improves the comments in the model's folder now (experimental)"
                       data-testid="improve-comments-run">Improve with Claude Code</MudButton>
          }
          else if (Runner?.Source is AiSource.Copilot)
          {
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="dep-ai-ask" StartIcon="@AiProvider.Copilot.Icon"
                       Disabled="@(IsEmpty || IsLocked || isHandingToCopilot)" OnClick="ImproveWithCopilotAsync"
                       title="Copilot Chat improves the comments in agent mode; you keep or undo each edit there"
                       data-testid="improve-comments-run-copilot">Improve with Copilot</MudButton>
          }
          else
          {
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="dep-ai-ask" StartIcon="@MudBlazor.Icons.Material.Outlined.ContentCopy"
                       Disabled="@IsEmpty" OnClick="CopyPromptAsync"
                       title="Copy the prompt for Claude Code, or another AI that can change the code"
                       data-testid="improve-comments-copy">Copy prompt</MudButton>
          }
          @if (HasMenu)
          {
            <AiProviderMenu Choice="choice" Need="AiCapability.EditCode" UnableText="Cannot change the code"
                            TestId="improve-comments"
                            Disabled="@(IsEmpty || IsLocked)" OnChoose="ChooseAsync" OnSettingsChanged="OnSettingsChanged">
              <MoreItems>
                @if (Runner is not null)
                {
                  <MudMenuItem Icon="@MudBlazor.Icons.Material.Outlined.ContentCopy" IconColor="Color.Secondary"
                               OnClick="CopyPromptAsync" data-testid="improve-comments-copy">
                    <div class="dep-ai-menu__item">
                      <div class="dep-ai-menu__name">Copy prompt</div>
                      <div class="dep-ai-menu__detail">For another AI that can change the code</div>
                    </div>
                  </MudMenuItem>
                }
              </MoreItems>
            </AiProviderMenu>
          }
        </span>
        <MudButton Size="Size.Small" Variant="Variant.Text" Class="dep-ai__show-prompt" Disabled="@IsEmpty"
                   title="Show the prompt that Claude Code gets, or that is copied" OnClick="ShowPromptAsync"
                   data-testid="improve-comments-show-prompt">Show prompt</MudButton>
      </div>
    }
    @if (Runner is null && !IsEmpty)
    {
      <div class="dep-ai__suggest-note mt-2" data-testid="improve-comments-no-claude-code">
        Paste the prompt into Claude Code, or another AI that can change the code. Turn on Claude Code in Settings › AI
        (in VS Code), or use Copilot in VS Code, to run it from here.
      </div>
    }
    @if (copyNote is not null)
    {
      <div class="dep-ai__suggest-note mt-2" data-testid="improve-comments-copied">@copyNote</div>
    }
    @if (copilotError is not null)
    {
      <div class="dep-ai__suggest-error mt-2" data-testid="improve-comments-copilot-error">@copilotError</div>
    }
    @if (CanRun)
    {
      <ClaudeCodeFix @ref="fixPanel" TestId="improve-comments" GetFixPrompt="Prompt" OnStateChanged="StateHasChanged"
                     RunningText="Claude Code is improving the comments…" ConfirmTitle="Improve comments with Claude Code?"
                     ConfirmYesText="Improve anyway" />
    }
  </DialogContent>
  <DialogActions>
    @if (IsDone)
    {
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close" data-testid="improve-comments-done">Done</MudButton>
    }
    else
    {
      <MudButton OnClick="Close" data-testid="improve-comments-cancel">Close</MudButton>
    }
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  // The node's long name, or "the N selected nodes".
  [Parameter] public string Name { get; set; } = "";
  [Parameter] public bool IsSeveral { get; set; }
  [Parameter] public bool HasChildren { get; set; }

  // Whether "Improve with Claude Code" can run here: the route is on and the model has a folder.
  [Parameter] public bool CanRun { get; set; }

  [Parameter, EditorRequired] public Func<bool, CommentsScope> GetScope { get; set; } = null!;
  [Parameter, EditorRequired] public Func<bool, string> GetPrompt { get; set; } = null!;

  ClaudeCodeFix? fixPanel;
  AiChoice choice = AiChoice.ChatOnly;
  bool isBelow;
  CommentsScope scope = new(0, 0);
  string? copyNote;
  string? copilotError;
  bool isHandingToCopilot;

  // Claude Code runs or ran: the scope stays as it was asked.
  bool IsLocked => fixPanel is { IsRunning: true } or { HasChanged: true };

  bool IsDone => fixPanel is { HasChanged: true };

  bool IsEmpty => scope.Targets == 0;

  // The provider the main button runs: the default where it changes code here, or else the first
  // that does (Claude Code before Copilot); none where only a copied prompt can.
  // Before the choice is read (it lists VS Code's models first), Claude Code where it can run.
  AiProvider? Runner => choice.DefaultFor(AiCapability.EditCode) ?? (CanRun ? AiProvider.ClaudeCode : null);

  // The menu lists the providers that answer, greyed (only Claude Code and Copilot change code), and
  // leads to AI settings, where Claude Code is turned on; the standalone browser app has neither.
  bool HasMenu => aiService.IsAvailable;

  string CountText =>
    scope.Targets == 0
      ? "Nothing here has a comment Dependinator reads: only projects, namespaces and types (Bicep modules and resources) do."
      : $"{TargetsText} in {Count(scope.Files, "file", "files")}";

  string TargetsText
  {
    get
    {
      var others = scope.Targets - scope.Projects;
      var projects = Count(scope.Projects, "project", "projects");
      var parts = Count(others, "namespace or type", "namespaces and types");
      return scope.Projects == 0 ? parts : others == 0 ? projects : $"{projects}, {parts}";
    }
  }

  // A node with children starts with everything inside it: commenting a namespace alone is rarely the point.
  protected override async Task OnInitializedAsync()
  {
    isBelow = HasChildren;
    scope = GetScope(isBelow);
    await RefreshChoiceAsync();
  }

  // An AI chat cannot change code, and Claude Code is listed only where it can run here.
  async Task RefreshChoiceAsync() =>
    choice = (await aiService.GetChoiceAsync()).Where(p =>
      p.Source is not AiSource.Chat && (p.Source is not AiSource.ClaudeCode || CanRun));

  // Only Claude Code and Copilot can be chosen here (the others are greyed).
  Task ChooseAsync(AiProvider provider) =>
    provider.Source switch
    {
      AiSource.ClaudeCode when CanRun => fixPanel!.StartAsync(),
      AiSource.Copilot when !IsLocked && !isHandingToCopilot => ImproveWithCopilotAsync(),
      _ => Task.CompletedTask,
    };

  // Copilot Chat makes the change in its own view: the dialog only says so.
  async Task ImproveWithCopilotAsync()
  {
    copyNote = null;
    copilotError = null;
    isHandingToCopilot = true;
    var handed = await aiService.FixWithCopilotAsync(Prompt());
    isHandingToCopilot = false;
    copyNote = handed is Error ? null : AiService.CopilotFixNote;
    copilotError = handed is Error e ? e.Message : null;
  }

  // Turning Claude Code on in AI settings shows up the next time the dialog opens: whether it can
  // run also needs the model's folder, which the dialog is given when it opens.
  Task OnSettingsChanged() => RefreshChoiceAsync();

  void SetBelow(bool value)
  {
    isBelow = value;
    scope = GetScope(isBelow);
    copyNote = null;
    copilotError = null;
  }

  string Prompt() => GetPrompt(isBelow);

  async Task CopyPromptAsync()
  {
    copilotError = null;
    copyNote = await clipboardService.CopyAsync(Prompt())
      ? "The prompt is copied. Paste it into Claude Code, or another AI that can change the code, then re-parse to see the comments."
      : "Could not copy to the clipboard.";
  }

  Task ShowPromptAsync() => PromptDialog.ShowAsync(dialogService, Prompt());

  static string Count(int count, string one, string many) => count == 1 ? $"1 {one}" : $"{count:N0} {many}";

  void Close() => MudDialog.Close();
}
