@using System.Globalization
@using Dependinator.UI.Diagrams.Interaction
@using Dependinator.UI.Diagrams.Svg
@using Dependinator.UI.Modeling
@using Dependinator.UI.Modeling.Models
@using Dependinator.UI.Shared.Types
@using Microsoft.AspNetCore.Components.Web
@inject IApplicationEvents applicationEvents
@inject IViewOptions viewOptions
@inject IModelMgr modelMgr
@inject IScreenService screenService
@inject IPanZoomService panZoomService
@inject IConfigService configService
@implements IDisposable

@* The minimap: an overview in the corner with a frame for the part currently on screen. It shows
   the whole model while the view is large, and zooms in with the view (MinimapGeometry.Window)
   so the frame never becomes a dot: deep inside a container it shows that container's surroundings
   and scrolls as the view moves. Boxes are drawn as deep as they are big enough to see. Clicking
   or dragging in it pans the diagram there (the zoom stays). Drawn from node bounds, not tiles.
   The boxes are rebuilt only when the shown window or the model changes (see TryGetScene); a
   pan inside the window just moves the frame. *@
@if (viewOptions.IsMinimapShown && TryGetScene(out var scene))
{
  <div class="dep-minimap dep-toolbar-card" data-testid="minimap">
    <svg class="dep-minimap__svg" width="@W" height="@H" viewBox="0 0 @W @H"
         @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp" @onpointerdown:preventDefault="true">
      @* One markup string for all boxes and labels: an unchanged scene costs Blazor a string
         comparison, not a diff of hundreds of elements (and Razor reserves <text> anyway). *@
      @scene.Content
      <rect x="@F(scene.Viewport.X)" y="@F(scene.Viewport.Y)" width="@F(scene.Viewport.Width)" height="@F(scene.Viewport.Height)"
            class="dep-minimap__viewport" pointer-events="none" data-testid="minimap-viewport" />
    </svg>
    <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" Class="dep-minimap__close"
                   title="Hide the minimap (View › Show Minimap brings it back)" OnClick="HideAsync" data-testid="minimap-close" />
  </div>
}

@code {
  const string W = "200";
  const string H = "130";

  record Scene(MarkupString Content, Rect Viewport);

  // Keeps the map from jumping: the part of the model shown last time (see MinimapGeometry.Window).
  Rect? window;
  MinimapFit? currentFit;
  bool isDragging;

  // The drawn boxes and labels, kept while the shown window and the model stay the same. Nodes
  // are laid out while tiles render, without a model-changed event, so a cached scene is also
  // refreshed once it is older than CacheMaxAge (at most a couple of rebuilds per second while
  // panning, instead of one per pointer move).
  static readonly TimeSpan CacheMaxAge = TimeSpan.FromMilliseconds(500);
  MarkupString cachedContent;
  Rect cachedWindow = Rect.None;
  int cachedModelVersion = -1;
  DateTime cachedAt;
  int modelVersion;

  // Boxes smaller than this (map px) are not drawn; a box must be this big to show its children.
  const double MinBoxSize = 2;
  const double MinOpenWidth = 30;
  const double MinOpenHeight = 20;
  const int MaxBoxes = 600;

  protected override void OnInitialized()
  {
    applicationEvents.ViewChanged += OnChanged;
    applicationEvents.UIStateChanged += OnChanged;
    applicationEvents.ModelChanged += OnModelChanged;
  }

  void OnChanged() => InvokeAsync(StateHasChanged);

  void OnModelChanged()
  {
    modelVersion++;
    InvokeAsync(StateHasChanged);
  }

  static string F(double value) => Math.Round(value, 1).ToString(CultureInfo.InvariantCulture);

  // The part of the model around the view, with every node inside it that is big enough to
  // see, placed where the diagram places it and scaled into the box; the frame is the viewport
  // in canvas units.
  bool TryGetScene(out Scene scene)
  {
    scene = null!;
    using var model = modelMgr.UseModel();
    var tops = model.Root.Children.Where(n => !n.IsNote && !n.IsHidden).ToList();
    if (tops.Count == 0 || model.Zoom <= 0)
      return false;

    var bounds = Union(tops.Select(n => CanvasRect(n)));
    if (bounds.Width <= 0 || bounds.Height <= 0)
      return false;

    var svgRect = screenService.SvgRect;
    var viewport = new Rect(model.Offset.X, model.Offset.Y, svgRect.Width * model.Zoom, svgRect.Height * model.Zoom);
    var shown = MinimapGeometry.Window(window, viewport, bounds);
    window = shown;
    var fit = MinimapGeometry.Fit(shown);
    currentFit = fit;

    var now = DateTime.UtcNow;
    if (shown != cachedWindow || modelVersion != cachedModelVersion || now - cachedAt > CacheMaxAge)
    {
      cachedContent = (MarkupString)DrawScene(model.Root, fit);
      (cachedWindow, cachedModelVersion, cachedAt) = (shown, modelVersion, now);
    }
    scene = new Scene(cachedContent, MinimapGeometry.Clamp(fit.ToMinimap(viewport)));
    return true;
  }

  // The boxes and labels of every node big enough to see, as SVG markup.
  static string DrawScene(Node root, MinimapFit fit)
  {
    var svg = new System.Text.StringBuilder();
    var boxCount = 0;
    Draw(root, new Pos(0, 0), 1.0, 1);
    return svg.ToString();

    // Walks down as long as boxes stay big enough to show their inside (the same placement
    // arithmetic as Node.GetPosAndZoom, done incrementally).
    void Draw(Node parent, Pos parentPos, double parentZoom, int depth)
    {
      var zoom = parent.ContainerZoom * parentZoom;
      foreach (var child in parent.Children)
      {
        if (boxCount >= MaxBoxes)
          return;
        if (child.IsNote || child.IsHidden)
          continue;
        var pos = new Pos(
          parentPos.X + child.Boundary.X * zoom + parent.ContainerOffset.X * parentZoom,
          parentPos.Y + child.Boundary.Y * zoom + parent.ContainerOffset.Y * parentZoom
        );
        var box = fit.ToMinimap(new Rect(pos.X, pos.Y, child.Boundary.Width * zoom, child.Boundary.Height * zoom));
        if (box.X + box.Width < 0 || box.Y + box.Height < 0 || box.X > MinimapGeometry.Width || box.Y > MinimapGeometry.Height)
          continue;
        if (box.Width < MinBoxSize && box.Height < MinBoxSize)
          continue;

        // A pass-through namespace covers its parent; draw its contents, not a second box.
        if (!child.IsPassThrough)
        {
          var (border, background) = NodeSvg.NodeColors(child);
          boxCount++;
          svg.Append($"<rect x=\"{F(box.X)}\" y=\"{F(box.Y)}\" width=\"{F(box.Width)}\" height=\"{F(box.Height)}\"")
            .Append($" rx=\"1.5\" fill=\"{background}\" stroke=\"{border}\" stroke-width=\"{(depth == 1 ? "1" : "0.5")}\"")
            .Append(" pointer-events=\"none\" />");
          if (box.Width >= 56 && box.Height >= 12 && !child.Type.IsMember)
          {
            svg.Append($"<text x=\"{F(box.X + 3)}\" y=\"{F(box.Y + 9)}\" class=\"dep-minimap__label\" pointer-events=\"none\">")
              .Append(System.Web.HttpUtility.HtmlEncode(Truncate(child.ShortName, (int)(box.Width / 5))))
              .Append("</text>");
          }
        }
        if (child.Children.Count > 0 && !child.Type.IsMember && box.Width >= MinOpenWidth && box.Height >= MinOpenHeight)
          Draw(child, pos, zoom, depth + 1);
      }
    }
  }

  static Rect CanvasRect(Node node)
  {
    var (pos, zoom) = node.GetPosAndZoom();
    return new Rect(pos.X, pos.Y, node.Boundary.Width * zoom, node.Boundary.Height * zoom);
  }

  static Rect Union(IEnumerable<Rect> rects)
  {
    double x1 = double.MaxValue, y1 = double.MaxValue, x2 = double.MinValue, y2 = double.MinValue;
    foreach (var r in rects)
    {
      x1 = Math.Min(x1, r.X);
      y1 = Math.Min(y1, r.Y);
      x2 = Math.Max(x2, r.X + r.Width);
      y2 = Math.Max(y2, r.Y + r.Height);
    }
    return x1 == double.MaxValue ? Rect.None : new Rect(x1, y1, x2 - x1, y2 - y1);
  }

  static string Truncate(string text, int maxChars) =>
    maxChars < 2 ? "" : text.Length <= maxChars ? text : text[..(maxChars - 1)] + "…";

  void OnPointerDown(PointerEventArgs e)
  {
    isDragging = true;
    PanTo(e.OffsetX, e.OffsetY);
  }

  void OnPointerMove(PointerEventArgs e)
  {
    if (isDragging && e.Buttons == 1)
      PanTo(e.OffsetX, e.OffsetY);
  }

  void OnPointerUp(PointerEventArgs e) => isDragging = false;

  void PanTo(double minimapX, double minimapY)
  {
    if (currentFit is not { } fit)
      return;
    panZoomService.PanTo(fit.ToCanvas(minimapX, minimapY));
  }

  async Task HideAsync()
  {
    viewOptions.SetMinimapShown(false);
    await configService.SetAsync(config => config.ShowMinimap = false);
    applicationEvents.TriggerUIStateChanged();
  }

  public void Dispose()
  {
    applicationEvents.ViewChanged -= OnChanged;
    applicationEvents.UIStateChanged -= OnChanged;
    applicationEvents.ModelChanged -= OnModelChanged;
  }
}
