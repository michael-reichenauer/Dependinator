@using Dependinator.UI.Diagrams.Ai
@using MudBlazor

@* Suggest rules (SuggestRulesService): an AI suggests architecture rules from the model's
   structure and dependencies (AiOpinion, open at once since asking is what the dialog is for).
   Dependinator checks each suggested rule itself and shows what it would break today, or why it
   cannot be added; the user ticks the ones to add. Each answer is kept while the dialog is open,
   and the ticks follow the answer shown. *@
<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">Suggest Rules</MudText>
  </TitleContent>
  <DialogContent>
    <div class="dep-about__comment" data-testid="suggest-rules-intro">
      An AI reads the model's structure and dependencies and suggests rules that guard its architecture.
      Dependinator checks each rule on the model before you add it.
    </div>
    <AiOpinion TAnswer="RuleSuggestions" TestId="suggest-rules" GetPrompt="GetPrompt" Ask="Ask"
               ParsePasted="ParsePasted" OnAnswerSelected="OnAnswerSelected" IsExpandedAtStart="true"
               ExpandText="Ask AI for rules" AnswerTitle="Suggested rules"
               RouteText="Claude reads the model's structure and dependencies and suggests rules here."
               AskTitle="Ask Claude to suggest rules for this model"
               CopyTitle="Copy a prompt with the model's structure and dependencies"
               PromptCopiedText="The prompt is copied, with the model's structure and dependencies.">
      <AnswerContent Context="a">
        <div class="dep-ai__suggestion" data-testid="suggest-rules-answer">
          <div class="dep-ai__suggestion-verdict">@($"{a.Source.Name()} suggests {a.Verdict}")</div>
          @foreach (var rule in a.Rules)
          {
            <div class="dep-suggest-rules__rule" data-testid="suggest-rules-item" data-can-add="@(rule.CanAdd ? "yes" : "no")">
              <div class="dep-suggest-rules__head">
                @if (rule.CanAdd)
                {
                  <MudCheckBox T="bool" Value="@chosen.Contains(rule)" ValueChanged="@(on => Choose(rule, on))"
                               Size="Size.Small" Dense="true" data-testid="suggest-rules-choose" />
                }
                else
                {
                  <MudIcon Icon="@MudBlazor.Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Default" />
                }
                <span class="dep-rules__names">
                  <b>@Title(rule.Check.FromTitle, rule.From)</b> <span class="dep-rules__arrow">must not use</span>
                  <b>@Title(rule.Check.ToTitle, rule.To)</b>
                </span>
                <span class="dep-panel__count" data-testid="suggest-rules-status">@Status(rule)</span>
              </div>
              @if (rule.Check.Error is { } error)
              {
                <div class="dep-ai__suggestion-note dep-suggest-rules__error" data-testid="suggest-rules-error">@error</div>
              }
              @if (rule.Why != "")
              {
                <div class="dep-ai__suggestion-note">@rule.Why</div>
              }
            </div>
          }
        </div>
      </AnswerContent>
    </AiOpinion>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel" data-testid="suggest-rules-cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(chosen.Count == 0)" OnClick="Add"
               data-testid="suggest-rules-add">@AddText</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  // The prompt for any AI, to copy or show.
  [Parameter, EditorRequired] public Func<Task<string>> GetPrompt { get; set; } = null!;

  // Asks Claude (or Claude Code), telling each step; null where the host cannot ask.
  [Parameter] public Func<AiSource, Action<SuggestStep>, Task<Result<RuleSuggestions>>>? Ask { get; set; }

  // Reads an AI chat's answer, pasted back, and checks its rules.
  [Parameter, EditorRequired] public Func<string, Result<RuleSuggestions>> ParsePasted { get; set; } = null!;

  readonly List<SuggestedRule> chosen = [];

  string AddText => chosen.Count switch
  {
    0 => "Add rules",
    1 => "Add 1 rule",
    var n => $"Add {n} rules",
  };

  // A new answer starts with every rule that can be added ticked.
  void OnAnswerSelected(RuleSuggestions answer)
  {
    chosen.Clear();
    chosen.AddRange(answer.Rules.Where(r => r.CanAdd));
  }

  void Choose(SuggestedRule rule, bool isChosen)
  {
    chosen.Remove(rule);
    if (isChosen)
      chosen.Add(rule);
  }

  static string Title(string title, string name) => title != "" ? title : name;

  static string Status(SuggestedRule rule) =>
    rule.Check switch
    {
      { Error: not null } => "cannot be added",
      { IsRule: true } => "already a rule",
      { ViolationCount: 0 } => "kept today",
      { ViolationCount: 1, LinkCount: var links } => $"1 broken ({Links(links)})",
      { ViolationCount: var count, LinkCount: var links } => $"{count} broken ({Links(links)})",
    };

  static string Links(int count) => count == 1 ? "1 link" : $"{count} links";

  void Cancel() => MudDialog.Cancel();

  void Add() => MudDialog.Close(DialogResult.Ok<IReadOnlyList<SuggestedRule>>([.. chosen]));
}
