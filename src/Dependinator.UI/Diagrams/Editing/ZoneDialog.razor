@using MudBlazor

<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">@(IsEdit ? "Edit zone" : "Add zone")</MudText>
  </TitleContent>
  <DialogContent>
    <MudTextField @ref="labelField" T="string" @bind-Value="Label" Label="Label" Immediate="true"
                  HelperText="Shown in the zone's top-left corner (e.g. Edge, Data, snet-apps)" OnKeyDown="OnKeyDown"
                  data-testid="zone-label" />
    <MudTextField T="string" @bind-Value="Subtitle" Label="Subtitle (optional)" Lines="2" Class="mt-3"
                  HelperText="Smaller text under the label" data-testid="zone-subtitle" />
  </DialogContent>
  <DialogActions>
    @if (IsEdit)
    {
      <MudButton Color="Color.Error" StartIcon="@MudBlazor.Icons.Material.Outlined.Delete" OnClick="Delete"
                 data-testid="zone-delete">Delete</MudButton>
    }
    <MudSpacer />
    <MudButton OnClick="Cancel" data-testid="zone-cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(!CanSave)"
               data-testid="zone-save">Save</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter] public string Label { get; set; } = "";
  [Parameter] public string Subtitle { get; set; } = "";
  [Parameter] public bool IsEdit { get; set; }

  MudTextField<string> labelField = null!;

  bool CanSave => !string.IsNullOrWhiteSpace(Label);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && labelField is not null)
    {
      await labelField.FocusAsync();
      await labelField.SelectAsync();
    }
  }

  void OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
      Save();
  }

  void Save()
  {
    if (!CanSave)
      return;
    MudDialog.Close(DialogResult.Ok(new ZoneDialogResult((Label ?? "").Trim(), (Subtitle ?? "").Trim(), false)));
  }

  void Delete() =>
      MudDialog.Close(DialogResult.Ok(new ZoneDialogResult((Label ?? "").Trim(), (Subtitle ?? "").Trim(), true)));

  void Cancel() => MudDialog.Cancel();
}
