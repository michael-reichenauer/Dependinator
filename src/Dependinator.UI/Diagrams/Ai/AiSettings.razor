@using MudBlazor
@using Dependinator.Core.Claude
@using Dependinator.Core.VsCodeModels
@inject IAiService aiService
@inject IApplicationEvents applicationEvents
@inject IJSInterop jsInterop
@implements IDisposable

@* The AI section of the Settings dialog (Settings › AI): the AI the app asks by default (AiChoice),
   the experimental Claude Code route, turned on only after a warning, since it uses the user's
   Claude login, the model each of Claude's routes asks (the API key's models, Claude Code's --model), and in VS Code the model the Copilot provider asks (VS Code's language models). Every place that asks uses the default, and its menu (▾) asks another provider once.
   Changes are saved at once. *@
<div id="@SectionId" data-testid="settings-ai-section">
    <div class="dep-about__text">
      The AI the app asks by default. Wherever the app asks, the menu next to the button asks another one, once.
    </div>
    @if (choice is not null)
    {
      <MudRadioGroup T="AiSource?" Value="choice.Default" ValueChanged="SetDefaultAsync" Class="dep-ai-settings"
                     data-testid="ai-settings">
        @foreach (var provider in AiProvider.All)
        {
          var isOffered = choice.Providers.Contains(provider);
          <div class="@($"dep-ai-settings__row {(isOffered ? "" : "dep-ai-settings__row--off")}")">
            <MudRadio T="AiSource?" Value="@((AiSource?)provider.Source)" Dense="true" Disabled="@(!isOffered)"
                      Color="Color.Primary" data-testid="@($"ai-settings-default-{provider.Id}")"
                      data-checked="@(choice.IsDefault(provider) ? "true" : "false")" />
            <MudIcon Icon="@provider.Icon" Size="Size.Small" Class="@($"dep-ai-settings__icon {provider.IconClass}")" />
            <div class="dep-ai-settings__text">
              <div>@provider.Name</div>
              <div class="dep-ai__route-meta">@(provider == AiProvider.Copilot && !isOffered ? CopilotMissingText : provider.Detail)</div>
            </div>
            @if (provider == AiProvider.ClaudeCode)
            {
              <MudSwitch T="bool" Value="isClaudeCodeOn" ValueChanged="ToggleClaudeCodeAsync" Color="Color.Primary"
                         title="Experimental: run the claude command on this computer with your own Claude login"
                         data-testid="ai-settings-use-claude-code" data-checked="@(isClaudeCodeOn ? "true" : "false")" />
            }
          </div>
          @if (provider == AiProvider.Claude && isOffered)
          {
            <div class="dep-ai-settings__model" data-testid="ai-settings-claude-model-row" data-value="@(claudeModelId ?? "")">
              <MudSelect T="string" Value="@(claudeModelId ?? "")" ValueChanged="SetClaudeModelAsync" Dense="true"
                         Margin="Margin.Dense" Variant="Variant.Outlined" Label="Model"
                         HelperText="@ClaudeModelsHint" data-testid="ai-settings-claude-model">
                <MudSelectItem T="string" Value="@("")">@ClaudeAutomaticText</MudSelectItem>
                @foreach (var model in ClaudeModelItems)
                {
                  <MudSelectItem T="string" Value="@model.Id">@model.Name</MudSelectItem>
                }
              </MudSelect>
            </div>
          }
          @if (provider == AiProvider.ClaudeCode && isClaudeCodeOn)
          {
            <div class="dep-ai-settings__model" data-testid="ai-settings-claude-code-model-row" data-value="@(claudeCodeModel ?? "")">
              <MudSelect T="string" Value="@ClaudeCodeModelPick" ValueChanged="PickClaudeCodeModelAsync" Dense="true"
                         Margin="Margin.Dense" Variant="Variant.Outlined" Label="Model"
                         data-testid="ai-settings-claude-code-model">
                <MudSelectItem T="string" Value="@("")">@ClaudeCodeAutomaticText</MudSelectItem>
                @foreach (var alias in ClaudeCodeAliases)
                {
                  <MudSelectItem T="string" Value="@alias.Model">@alias.Name</MudSelectItem>
                }
                <MudSelectItem T="string" Value="@OtherModel">Another model …</MudSelectItem>
              </MudSelect>
              @if (isOtherClaudeCodeModel)
              {
                <MudTextField T="string" Value="@(claudeCodeModel ?? "")" ValueChanged="SetOtherClaudeCodeModelAsync"
                              Error="@(claudeCodeModelError != "")" ErrorText="@claudeCodeModelError"
                              Margin="Margin.Dense" Variant="Variant.Outlined" Label="Model name" Class="mt-2"
                              HelperText="A full model name, such as claude-opus-5-5"
                              data-testid="ai-settings-claude-code-model-name" />
              }
            </div>
          }
          @if (provider == AiProvider.Copilot && isOffered)
          {
            <div class="dep-ai-settings__model">
              <MudSelect T="string" Value="@(copilotModelId ?? "")" ValueChanged="SetCopilotModelAsync" Dense="true"
                         Margin="Margin.Dense" Variant="Variant.Outlined" Label="Model" data-testid="ai-settings-copilot-model">
                <MudSelectItem T="string" Value="@("")">@AutomaticText</MudSelectItem>
                @foreach (var model in copilotModels)
                {
                  <MudSelectItem T="string" Value="@model.Id">@ModelName(model)</MudSelectItem>
                }
              </MudSelect>
            </div>
          }
          @if (provider == AiProvider.ClaudeCode && isConfirmingClaudeCode)
          {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" data-testid="ai-settings-claude-code-warning">
              <div>
                Claude Code runs the claude command on this computer with your own Claude login, instead of an Anthropic
                API key. The prompt includes excerpts of your source code.
              </div>
              <div class="mt-1">
                It is unclear whether Anthropic's terms allow a third-party tool to use a Claude subscription this way, so
                use it for your own experiments only, at your own risk.
              </div>
              <div class="mt-1">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmClaudeCodeAsync"
                           data-testid="use-claude-code-confirm">Use Claude Code</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => isConfirmingClaudeCode = false"
                           data-testid="use-claude-code-cancel">Cancel</MudButton>
              </div>
            </MudAlert>
          }
        }
      </MudRadioGroup>
      @if (choice.Default is null)
      {
        <div class="dep-ai__route-meta" data-testid="ai-settings-no-default">
          No default yet: the first time you ask, the app shows the choices, and the one you pick becomes the default.
        </div>
      }
    }
</div>

@code {
  const string SectionId = "dep-settings-ai";

  // Opened from an AI provider menu's "AI settings …": scrolls the section into view once its
  // choices are shown (they arrive asynchronously, over RPC in VS Code).
  [Parameter] public bool ScrollIntoView { get; set; }

  bool isScrolled;
  AiChoice? choice;
  bool isClaudeCodeOn;
  bool isConfirmingClaudeCode;
  VsCodeModel[] copilotModels = [];
  string? copilotModelId;
  ClaudeModel[] claudeModels = [];
  string? claudeModelId;
  string? claudeCodeModel;
  bool isOtherClaudeCodeModel;
  string claudeCodeModelError = "";
  bool isDisposed;

  // Claude Code's names for the latest model of each kind; it has no command that lists its models.
  static readonly (string Model, string Name)[] ClaudeCodeAliases =
  [
    ("fable", "Fable (latest)"),
    ("opus", "Opus (latest)"),
    ("sonnet", "Sonnet (latest)"),
    ("haiku", "Haiku (latest)"),
  ];

  // The select's value for a model that is no alias: typed in the field below it.
  const string OtherModel = "other";

  const string ClaudeAutomaticText = "Automatic: Opus or Sonnet, by task";
  const string ClaudeCodeAutomaticText = "Automatic: Claude Code's own setting";

  protected override async Task OnInitializedAsync()
  {
    // Listed afresh: Copilot may have started or signed in since.
    copilotModels = await aiService.GetCopilotModelsAsync(isFresh: true);
    await RefreshAsync();
    isOtherClaudeCodeModel = claudeCodeModel is { } model && ClaudeCodeAliases.All(a => a.Model != model);
    // Claude's models come over the network: the section shows first, the list when it arrives.
    _ = LoadClaudeModelsAsync();
  }

  async Task LoadClaudeModelsAsync()
  {
    claudeModels = await aiService.GetClaudeModelsAsync(isFresh: true);
    isClaudeModelsLoaded = true;
    if (!isDisposed)
      await InvokeAsync(StateHasChanged);
  }

  bool isClaudeModelsLoaded;

  public void Dispose() => isDisposed = true;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!ScrollIntoView || isScrolled || choice is null)
      return;
    isScrolled = true;
    await jsInterop.Call("scrollIntoView", SectionId);
  }

  async Task RefreshAsync()
  {
    copilotModels = await aiService.GetCopilotModelsAsync();
    choice = await aiService.GetChoiceAsync();
    isClaudeCodeOn = choice.Providers.Contains(AiProvider.ClaudeCode);
    // A picked model VS Code no longer offers shows as the automatic choice, which the extension
    // then asks instead.
    var modelId = await aiService.GetCopilotModelIdAsync();
    copilotModelId = copilotModels.Any(m => m.Id == modelId) ? modelId : null;

    claudeModelId = await aiService.GetClaudeModelIdAsync();
    claudeCodeModel = await aiService.GetClaudeCodeModelAsync();
  }

  // The listed models, and the picked one when the list lacks it (no key yet, the list could not
  // be fetched, or Anthropic retired the model: an ask then says so), so the pick stays visible.
  IEnumerable<ClaudeModel> ClaudeModelItems =>
    claudeModelId is { } id && claudeModels.All(m => m.Id != id) ? [.. claudeModels, new ClaudeModel(id, id)] : claudeModels;

  // A picked model answers everything; an empty list has more than one cause (no key yet, a key
  // Claude did not accept, no network), which an ask then tells apart.
  string ClaudeModelsHint =>
    claudeModelId is not null ? "Used for everything the app asks Claude"
    : isClaudeModelsLoaded && claudeModels.Length == 0 ? "No models to list: they show once Claude can be reached with an API key"
    : "";

  string ClaudeCodeModelPick => isOtherClaudeCodeModel ? OtherModel : claudeCodeModel ?? "";

  async Task SetClaudeModelAsync(string modelId)
  {
    await aiService.SetClaudeModelAsync(modelId == "" ? null : modelId);
    await ChangedAsync();
  }

  // Picking "Another model …" shows the name field; nothing is saved until a name is typed.
  async Task PickClaudeCodeModelAsync(string model)
  {
    isOtherClaudeCodeModel = model == OtherModel;
    claudeCodeModelError = "";
    await aiService.SetClaudeCodeModelAsync(model is "" or OtherModel ? null : model);
    await ChangedAsync();
  }

  async Task SetOtherClaudeCodeModelAsync(string model)
  {
    model = model.Trim();
    // What the host would refuse (ClaudeCodeRunner.IsModelName) is not saved.
    claudeCodeModelError =
      model.StartsWith('-') || model.Length > 300 || model.Any(c => char.IsWhiteSpace(c) || char.IsControl(c))
        ? "A model name has no spaces and does not start with -"
        : "";
    if (claudeCodeModelError != "")
      return;
    await aiService.SetClaudeCodeModelAsync(model == "" ? null : model);
    await ChangedAsync();
  }

  async Task SetDefaultAsync(AiSource? source)
  {
    if (source is not { } s)
      return;
    await aiService.SetDefaultAsync(s);
    await ChangedAsync();
  }

  // Turning Claude Code on asks first; off needs no confirmation.
  async Task ToggleClaudeCodeAsync(bool isOn)
  {
    if (isOn)
    {
      isConfirmingClaudeCode = true;
      return;
    }
    isConfirmingClaudeCode = false;
    await aiService.SetClaudeCodeEnabledAsync(false);
    await ChangedAsync();
  }

  async Task ConfirmClaudeCodeAsync()
  {
    isConfirmingClaudeCode = false;
    await aiService.SetClaudeCodeEnabledAsync(true);
    await ChangedAsync();
  }

  async Task SetCopilotModelAsync(string modelId)
  {
    await aiService.SetCopilotModelAsync(modelId == "" ? null : modelId);
    await ChangedAsync();
  }

  // Why Copilot cannot be picked here.
  static string CopilotMissingText =>
    Dependinator.Core.Build.IsVsCodeExtWasm
      ? "VS Code offers no Copilot model: install GitHub Copilot Chat and sign in to it"
      : "A model VS Code offers, such as GitHub Copilot's: only in the VS Code extension";

  // The model asked when none is picked: Copilot's first, as the extension picks it (languageModels.ts).
  string AutomaticText =>
    copilotModels.FirstOrDefault(m => m.IsCopilots) is { } first
      ? $"Automatic: {ModelName(first)}"
      : "Automatic: no Copilot model, pick one";

  // "GPT-5 mini", or "Claude Sonnet 5.5 (anthropic)" for a model another extension adds.
  static string ModelName(VsCodeModel model) =>
    model.IsCopilots ? model.Name : $"{model.Name} ({model.Vendor})";

  async Task ChangedAsync()
  {
    await RefreshAsync();
    applicationEvents.TriggerUIStateChanged();
  }

}
