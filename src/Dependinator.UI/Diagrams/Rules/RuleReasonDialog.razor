@using MudBlazor

@* Edits why an architecture rule exists (ArchitectureRule.Reason), from the Rules panel. *@
<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">Why this rule</MudText>
  </TitleContent>
  <DialogContent>
    <MudText Typo="Typo.body2" Class="mb-2">@RuleText</MudText>
    <MudTextField @ref="reasonField" T="string" @bind-Value="Reason" Label="Why" Lines="3" Immediate="true"
                  HelperText="What the rule protects, for whoever reads it later" data-testid="rule-reason-text" />
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel" data-testid="rule-reason-cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" data-testid="rule-reason-save">Save</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  // The rule in words, as RuleReport.Text has it.
  [Parameter] public string RuleText { get; set; } = "";
  [Parameter] public string Reason { get; set; } = "";

  MudTextField<string> reasonField = null!;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && reasonField is not null)
      await reasonField.FocusAsync();
  }

  void Save() => MudDialog.Close(DialogResult.Ok((Reason ?? "").Trim()));

  void Cancel() => MudDialog.Cancel();
}
