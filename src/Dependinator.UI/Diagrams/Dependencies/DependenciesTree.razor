@using Dependinator.UI.Diagrams.Icons

@inject IApplicationEvents applicationEvents
@inject IDependenciesService srv
@inject IScreenService screenService
@inject IInteractionService interactionService
@inject ISelectionService selectionService
@implements IDisposable

<style>
    .hover-button {
        visibility: hidden;
    }

    .hover-element:hover .hover-button {
        visibility: visible;
    }
</style>

@* The popover is anchored to this empty fixed element, which sits just under the app bar and
   the breadcrumb (ToolbarPositioning.ChromeBottom) so the explorer never covers their buttons. *@
<div style="@AnchorStyle">
<MudPopover Open="IsShowExplorer" Fixed="true" Class="@(srv.IsMinimized ? "px-5 py-2" : "px-5 pt-4")"
            MaxHeight="MaxHeight" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopLeft">
    <MudStack Spacing="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @* Minimized (after a click elsewhere in the diagram), the title bar is all that is
               left; clicking it brings the tree back. The subject's name is only shown here
               then, as the subtitle line that normally carries it is hidden. *@
            <div style="@(srv.IsMinimized ? "display:flex;align-items:center;gap:8px;cursor:pointer;" : "display:flex;align-items:center;gap:8px;")"
                 @onclick="() => srv.SetMinimized(false)" data-testid="explorer-header">
                <MudText Class="ml-n2"><b>@HeadingText</b></MudText>
                @if (srv.IsMinimized)
                {
                    <MudText Color="Color.Info" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <b>@(srv.Title)</b>
                    </MudText>
                }
            </div>
            <MudSpacer />
            <MudTooltip Text="@(srv.IsShowLines ? "Hide the lines in the diagram" : "Show the lines in the diagram")">
                <MudIconButton Icon="@MudBlazor.Icons.Material.Outlined.Timeline" Size="Size.Small"
                               Color="@(srv.IsShowLines ? Color.Info : Color.Default)"
                               OnClick="() => srv.SetShowLines(!srv.IsShowLines)" data-testid="explorer-show-lines" />
            </MudTooltip>
            <MudTooltip Text="@IndirectTooltip">
                <MudIconButton Icon="@MudBlazor.Icons.Material.Outlined.DoubleArrow" Size="Size.Small"
                               Color="@(srv.IsIncludeIndirect ? Color.Info : Color.Default)"
                               OnClick="() => srv.SetIncludeIndirect(!srv.IsIncludeIndirect)" data-testid="explorer-indirect" />
            </MudTooltip>
            <MudTooltip Text="@(srv.IsLinesPinned ? "Lines are kept when selecting other nodes (click to unpin)" : "Keep the lines when selecting other nodes")">
                <MudIconButton Icon="@(srv.IsLinesPinned ? MudBlazor.Icons.Material.Filled.PushPin : MudBlazor.Icons.Material.Outlined.PushPin)"
                               Size="Size.Small" Color="@(srv.IsLinesPinned ? Color.Info : Color.Default)"
                               OnClick="() => srv.SetLinesPinned(!srv.IsLinesPinned)" data-testid="explorer-pin-lines" />
            </MudTooltip>
            <MudTooltip Text="Show references">
                <MudIconButton Icon="@Icon.ReferencesIcon" Size="Size.Small"
                               Color="@(srv.TreeType == TreeType.References ? Color.Info : Color.Default)"
                               OnClick="() => srv.ShowReferences()" data-testid="explorer-references" />
            </MudTooltip>
            <MudTooltip Text="Show dependencies">
                <MudIconButton Icon="@Icon.DependenciesIcon" Size="Size.Small"
                               Color="@(srv.TreeType == TreeType.Dependencies ? Color.Info : Color.Default)"
                               OnClick="() => srv.ShowDependencies()" data-testid="explorer-dependencies" />
            </MudTooltip>
            <MudTooltip Text="@(srv.IsMinimized ? "Restore" : "Minimize")">
                <MudIconButton Icon="@(srv.IsMinimized ? MudBlazor.Icons.Material.Filled.ExpandMore : MudBlazor.Icons.Material.Filled.ExpandLess)"
                               Size="Size.Small" OnClick="() => srv.SetMinimized(!srv.IsMinimized)"
                               data-testid="explorer-minimize" />
            </MudTooltip>
            <MudTooltip Text="Close (the lines stay until you select something else)">
                <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Close" Size="Size.Small"
                               OnClick="() => srv.Close()" data-testid="explorer-close" />
            </MudTooltip>
        </MudStack>
        @if (!srv.IsMinimized)
        {
        <MudText Typo="Typo.body2" Class="ml-n2 mud-text-secondary" data-testid="explorer-subtitle">
            @(srv.SubtitleBefore)<b style="color: var(--mud-palette-info);">@(srv.Title)</b>@(srv.SubtitleAfter)
        </MudText>
        <MudPaper Class="overflow-y-auto ml-n8" Elevation="0" MaxWidth="MaxWidth" MaxHeight="500px">
            <MudTreeView Items="@srv.TreeItems" Hover="true" Dense="true" Width="100%">
                <ItemTemplate Context="treeItem">
                    @{
                        var item = (TreeItem)treeItem;
                    }
                    <MudTreeViewItem Items="@item.Children" Icon="@item.Icon"
                                     OnClick="() => OnItemClickAsync(item)" Expanded="@item.Expanded"
                                     ExpandedChanged="(bool expanded) => srv.SetExpanded(item, expanded)">
                        <BodyContent>
                            <div style="display: grid; grid-template-columns: 1fr auto; align-items: center; width: 100%"
                                 class="hover-element">

                                <div style="justify-self: start; display: flex; align-items: baseline; gap: 6px;">
                                    <MudText Class="@(item.IsIndirect ? "mud-text-secondary" : "")">@item.Text</MudText>
                                    @if (item.LinkCount > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">(@item.LinkCount)</MudText>
                                    }
                                    else if (item.HopCount > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="explorer-hops">(@item.HopCount hops)</MudText>
                                    }
                                    else if (item.IsIndirect)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">(indirect)</MudText>
                                    }
                                </div>

                                @if (item.NodeId != Modeling.Models.NodeId.Empty)
                                {
                                    <div style="justify-self: end;">
                                        @if (item.Children?.Any() ?? false)
                                        {
                                            <MudTooltip Text="Expand/collapse all">
                                                <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Expand" Size="Size.Small"
                                                               Color="Color.Inherit" Class="ml-3 hover-button"
                                                               OnClick="() => srv.ToggleExpandAll(item)" data-testid="explorer-expand-all" />
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="Show node in diagram">
                                            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.CenterFocusStrong" Size="Size.Small"
                                                           Color="Color.Inherit" Class="ml-3 hover-button"
                                                           OnClick="() => srv.ShowNodeAsync(item.NodeId)" />
                                        </MudTooltip>
                                        @if (item.CanShowEditor)
                                        {
                                            <MudTooltip Text="Show source code">
                                                <MudIconButton Icon="@MudBlazor.Icons.Material.Outlined.Code" Size="Size.Small"
                                                               Color="Color.Inherit" Class="ml-3 hover-button"
                                                               OnClick="() => srv.ShowEditorAsync(item.NodeId)" />
                                            </MudTooltip>
                                        }
                                        @if (item.HopCount > 0)
                                        {
                                            <MudTooltip Text="@ChainTooltip">
                                                <MudIconButton Icon="@MudBlazor.Icons.Material.Outlined.AltRoute" Size="Size.Small"
                                                               Color="Color.Inherit" Class="ml-3 hover-button"
                                                               OnClick="() => srv.ShowChain(item.NodeId)" data-testid="explorer-show-chain" />
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="Show direct line to this node">
                                            <MudIconButton Icon="@Icon.DirectConnection"
                                                           Size="Size.Small" Color="Color.Inherit" Class="ml-3 hover-button"
                                                           OnClick="() => srv.ShowDirectLine(item.NodeId)" />
                                        </MudTooltip>
                                    </div>
                                }
                            </div>
                        </BodyContent>
                    </MudTreeViewItem>
                </ItemTemplate>
            </MudTreeView>
        </MudPaper>
        }
    </MudStack>
</MudPopover>
</div>


@code {
    bool IsShowExplorer => srv.IsShowExplorer;

    string HeadingText =>
        (srv.TreeType == TreeType.References ? "References" : "Dependencies") + (srv.IsMinimized ? ":" : "");

    string IndirectTooltip =>
        srv.IsIncludeIndirect ? "Indirect ones are included (click to list only direct ones)"
        : srv.TreeType == TreeType.References ? "Include indirect references: nodes that reach this node through other nodes"
        : "Include indirect dependencies: nodes this node reaches through other nodes";

    string ChainTooltip =>
        srv.TreeType == TreeType.References
            ? "Show the chain of dependencies from this node"
            : "Show the chain of dependencies to this node";

    const int Left = 15;

    string AnchorStyle => $"position:fixed;top:{(int)ToolbarPositioning.ChromeBottom}px;left:{Left}px;width:0;height:0;";

    int MaxHeight => (int)(screenService.SvgRect.Height - ToolbarPositioning.ChromeBottom) - 15;
    int MaxWidth => (int)screenService.SvgRect.Width - 2 * Left;

    Task OnItemClickAsync(TreeItem item) =>
        item.NodeId != Modeling.Models.NodeId.Empty ? srv.ShowNodeAsync(item.NodeId) : Task.CompletedTask;

    protected override void OnInitialized() => applicationEvents.UIStateChanged += OnUiStateChanged;

    void OnUiStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => applicationEvents.UIStateChanged -= OnUiStateChanged;
}
