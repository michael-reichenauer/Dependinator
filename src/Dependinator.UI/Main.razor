@using Dependinator.UI.App
@inject IThemeService themeService
@implements IDisposable

<MudThemeProvider Theme="DependinatorTheme" IsDarkMode="@themeService.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <Canvas />
</MudLayout>

@code {
    MudTheme DependinatorTheme = new MudTheme
    {
        PaletteLight = new PaletteLight()
        {
            AppbarBackground = Colors.DeepPurple.Accent4,
            AppbarText = Colors.DeepPurple.Lighten5,
            Tertiary = Colors.DeepPurple.Darken2,
        },
        PaletteDark = new PaletteDark()
        {
            AppbarBackground = Colors.DeepPurple.Darken4,
            AppbarText = Colors.DeepPurple.Lighten5,
            Secondary = Colors.DeepPurple.Lighten4,
            Primary = Colors.DeepPurple.Lighten5,
            // The primary is near white, so filled primary buttons and the selection badge need
            // dark text (MudBlazor's default contrast text is white).
            PrimaryContrastText = Colors.DeepPurple.Darken4,
            Tertiary = Colors.DeepPurple.Lighten3,
        },
    };

    protected override void OnInitialized() => themeService.Changed += OnThemeChanged;

    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => themeService.Changed -= OnThemeChanged;
}
