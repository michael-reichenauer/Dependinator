@using Dependinator.Core
@using Dependinator.Core.Shared
@using Dependinator.UI.Modeling
@using Dependinator.UI.Modeling.Commands

@inject ICanvasService canvasService
@inject Dependinator.UI.Modeling.Models.IModelMgr modelMgr
@inject ICommandService commandService
@inject IApplicationEvents applicationEvents
@inject IModelService modelService
@inject IDialogService dialogService
@inject IJSInterop jsInterop
@inject IVsCodeSendService vsCodeSendService
@inject IIssueReportService issueReportService
@inject Dependinator.UI.Diagrams.Annotations.INoteService noteService
@inject Dependinator.UI.Diagrams.Annotations.IZoneService zoneService
@inject Dependinator.UI.Diagrams.Annotations.ILineLabelsService lineLabelsService
@inject Dependinator.UI.Diagrams.Editing.IManualEditService manualEditService
@inject Dependinator.UI.Diagrams.Export.IExportService exportService
@inject Dependinator.UI.Diagrams.Dependencies.IDependenciesService dependenciesService
@inject Dependinator.UI.Diagrams.IViewOptions viewOptions
@inject Dependinator.UI.Diagrams.IPanelService panelService
@inject Dependinator.UI.Diagrams.IViewSettingsService viewSettings
@inject Dependinator.UI.Diagrams.Navigation.IPathFinderService pathFinderService
@inject Dependinator.UI.Diagrams.HiddenNodes.IHiddenNodeService hiddenNodeService
@inject Dependinator.UI.Diagrams.Tours.ICoachService coachService
@inject IShareLinkService shareLinkService
@inject IThemeService themeService
@inject IKeyboardService keyboardService
@inject Dependinator.UI.Diagrams.Interaction.IViewHistoryService viewHistory
@inject Dependinator.UI.Diagrams.Ask.IAskModelService askModelService
@inject Dependinator.UI.Diagrams.Tours.ITourService tourService
@implements IDisposable

<MudButtonGroup Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Text" Class="dep-toolbar-card"
                Style="@CssPosition">
    @* Not shown on focus: the button gets the focus back when its menu (or a dialog opened from
       it) closes, and the tooltip then stayed up over the breadcrumb bar's first button. *@
    <MudTooltip Text="Menu" ShowOnFocus="false">
        <MudMenu Icon="@Icons.Material.Outlined.Menu" IconColor="Color.Tertiary" Dense="true" AriaLabel="Menu"
                 AnchorOrigin="Origin.BottomCenter" PopoverClass="@MenuClass" data-testid="appbar-menu">
            <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Search" OnClick="OpenSearchAsync"
                         data-testid="menu-search">
                Search …
            </MudMenuItem>

            <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.FitScreen"
                         OnClick="canvasService.PanZoomToFit" data-testid="menu-fit-to-screen">
                Fit to Screen
            </MudMenuItem>

            <MudDivider />

            <MudMenu Label="Edit" PopoverClass="@MenuClass" data-testid="menu-edit">
                <MudMenuItem IconColor="Color.Secondary" Icon="@EditModeIcon" OnClick="ToggleEditMode"
                             title="Move, resize, link, color and add nodes. Off: the diagram is view-only."
                             data-checked="@(viewOptions.IsEditingEnabled ? "true" : "false")"
                             data-testid="menu-edit-mode">
                    Edit Mode
                </MudMenuItem>

                <MudDivider />

                <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">History</MudText>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Undo"
                             Disabled="@(!commandService.CanUndo)" OnClick="commandService.Undo" data-testid="menu-undo">
                    Undo
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Redo"
                             Disabled="@(!commandService.CanRedo)" OnClick="commandService.Redo" data-testid="menu-redo">
                    Redo
                </MudMenuItem>

                @if (viewOptions.IsEditingEnabled)
                {
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Insert</MudText>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.AddBox" OnClick="BeginAddNode"
                                 data-testid="menu-add-node">
                        Add Node …
                    </MudMenuItem>

                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.StickyNote2"
                                 OnClick="BeginAddNote" data-testid="menu-add-note">
                        Add Note …
                    </MudMenuItem>

                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.SelectAll"
                                 OnClick="BeginAddZone" title="A labeled background area that groups the nodes drawn over it."
                                 data-testid="menu-add-zone">
                        Add Zone …
                    </MudMenuItem>

                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.AutoAwesome"
                                 OnClick="() => lineLabelsService.SuggestLabelsAsync(null)"
                                 title="An AI suggests labels for the lines without one; you pick the ones to add."
                                 data-testid="menu-suggest-line-labels">
                        Suggest Line Labels …
                    </MudMenuItem>
                }
            </MudMenu>

            <MudMenu Label="Export" PopoverClass="@MenuClass" data-testid="menu-export">
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.HighlightAlt"
                             OnClick="BeginExportArea" data-testid="menu-export-area">
                    Select Area …
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Screenshot"
                             OnClick="exportService.ExportCurrentViewAsync" data-testid="menu-export-view">
                    Current View …
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Image"
                             OnClick="exportService.ExportEntireDiagramAsync" data-testid="menu-export-diagram">
                    Entire Diagram …
                </MudMenuItem>

                <MudDivider />

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Link"
                             OnClick="shareLinkService.CopyViewLinkAsync"
                             title="Copies a dependinator.com link that opens this model at the current view."
                             data-testid="menu-copy-view-link">
                    Link to Current View
                </MudMenuItem>
            </MudMenu>

            <MudMenu Label="View" PopoverClass="@MenuClass" data-testid="menu-view">
                <MudMenuItem IconColor="Color.Secondary" Icon="@RevealHiddenNodesIcon" OnClick="viewSettings.ToggleRevealHiddenNodes"
                             data-checked="@(viewOptions.RevealHiddenNodes ? "true" : "false")"
                             title="Draws hidden nodes faintly, to find them again (not saved)."
                             data-testid="menu-reveal-hidden-nodes">
                    Reveal Hidden Nodes
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@HiddenNodesListIcon" OnClick="ToggleHiddenNodes"
                             title="Lists the nodes you dimmed or hid, to change them or show them again."
                             data-checked="@(viewOptions.IsHiddenNodesShown ? "true" : "false")"
                             data-testid="menu-hidden-nodes">
                    Show Hidden Nodes List
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@NotesSidebarIcon" OnClick="noteService.ToggleSidebar"
                             data-checked="@(noteService.IsShowSidebar ? "true" : "false")"
                             data-testid="menu-notes-sidebar">
                    Show Notes Sidebar
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@MinimapIcon" OnClick="viewSettings.ToggleMinimapAsync"
                             title="A small overview in the corner; click or drag in it to move the view."
                             data-checked="@(viewOptions.IsMinimapShown ? "true" : "false")"
                             data-testid="menu-minimap">
                    Show Minimap
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@LegendIcon" OnClick="viewSettings.ToggleLegend"
                             data-checked="@(viewOptions.IsLegendShown ? "true" : "false")"
                             data-testid="menu-legend">
                    Show Legend
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@CyclesIcon" OnClick="panelService.ToggleCycles"
                             title="Lists circular dependencies and draws their lines in red."
                             data-checked="@(viewOptions.IsCyclesShown ? "true" : "false")"
                             data-testid="menu-cycles">
                    Show Cycles
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@RulesIcon" OnClick="panelService.ToggleRules"
                             title="Declare which parts must not depend on which (or layers), and see the dependencies that break those rules."
                             data-checked="@(viewOptions.IsRulesShown ? "true" : "false")"
                             data-testid="menu-rules">
                    Show Architecture Rules
                </MudMenuItem>

                @if (askModelService.IsAvailable)
                {
                    <MudMenuItem IconColor="Color.Secondary" Icon="@AskIcon" OnClick="askModelService.Toggle"
                                 title="Ask an AI a question about the model; the nodes in its answer link to the diagram."
                                 data-checked="@(viewOptions.IsAskShown ? "true" : "false")"
                                 data-testid="menu-ask">
                        Ask About the Model
                    </MudMenuItem>
                }

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.AltRoute" OnClick="pathFinderService.Open"
                             title="Shows why one node depends on another: the shortest chain of dependencies between two nodes you choose."
                             data-testid="menu-find-path">
                    Find Path …
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.UnfoldLess"
                             OnClick="() => dependenciesService.SetShowLines(false)" data-testid="menu-hide-direct-lines">
                    Hide All Direct Lines
                </MudMenuItem>

                <MudMenu Label="@LinesMenuLabel" StartIcon="@Icons.Material.Outlined.FilterAlt" IconColor="Color.Secondary"
                         Dense="true" PopoverClass="@MenuClass" data-testid="menu-lines">
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Leave out</MudText>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideExternal)"
                                 OnClick="() => viewSettings.SetLineFilterAsync(LineFilter with { HideExternal = !LineFilter.HideExternal })"
                                 title="Lines to or from external packages and framework assemblies."
                                 data-checked="@(LineFilter.HideExternal ? "true" : "false")" data-testid="menu-lines-external">
                        Lines to Externals
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideInheritance)"
                                 OnClick="() => viewSettings.SetLineFilterAsync(LineFilter with { HideInheritance = !LineFilter.HideInheritance })"
                                 title="Base class and interface implementation lines (hollow arrow heads)."
                                 data-checked="@(LineFilter.HideInheritance ? "true" : "false")" data-testid="menu-lines-inheritance">
                        Inheritance Lines
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideMember)"
                                 OnClick="() => viewSettings.SetLineFilterAsync(LineFilter with { HideMember = !LineFilter.HideMember })"
                                 title="Lines that start or end at a method, property, field or event."
                                 data-checked="@(LineFilter.HideMember ? "true" : "false")" data-testid="menu-lines-member">
                        Member Lines
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideConfiguration)"
                                 OnClick="() => viewSettings.SetLineFilterAsync(LineFilter with { HideConfiguration = !LineFilter.HideConfiguration })"
                                 title="Lines that only carry values into parameters and variables (Bicep); the Dependencies explorer still lists them."
                                 data-checked="@(LineFilter.HideConfiguration ? "true" : "false")" data-testid="menu-lines-configuration">
                        Configuration Lines
                    </MudMenuItem>

                    <MudDivider />
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Show lines with</MudText>
                    @foreach (var (count, label) in MinLinkChoices)
                    {
                        <MudMenuItem IconColor="Color.Secondary" Icon="@RadioIcon(LineFilter.MinLinkCount == count)"
                                     OnClick="() => viewSettings.SetLineFilterAsync(LineFilter with { MinLinkCount = count })"
                                     data-checked="@(LineFilter.MinLinkCount == count ? "true" : "false")"
                                     data-testid="@($"menu-lines-min-{count}")">
                            @label
                        </MudMenuItem>
                    }
                </MudMenu>

                <MudMenu Label="@RowsMenuLabel" StartIcon="@Icons.Material.Outlined.FilterList" IconColor="Color.Secondary"
                         Dense="true" PopoverClass="@MenuClass" data-testid="menu-rows">
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Leave out</MudText>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(RowFilter.HideParameters)"
                                 OnClick="() => viewSettings.SetRowFilterAsync(RowFilter with { HideParameters = !RowFilter.HideParameters })"
                                 title="Parameter rows (Bicep) and their lines; the Dependencies explorer and search still list them."
                                 data-checked="@(RowFilter.HideParameters ? "true" : "false")" data-testid="menu-rows-parameters">
                        Parameter Rows
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(RowFilter.HideVariables)"
                                 OnClick="() => viewSettings.SetRowFilterAsync(RowFilter with { HideVariables = !RowFilter.HideVariables })"
                                 title="Variable rows (Bicep) and their lines."
                                 data-checked="@(RowFilter.HideVariables ? "true" : "false")" data-testid="menu-rows-variables">
                        Variable Rows
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(RowFilter.HideOutputs)"
                                 OnClick="() => viewSettings.SetRowFilterAsync(RowFilter with { HideOutputs = !RowFilter.HideOutputs })"
                                 title="Output rows (Bicep) and their lines."
                                 data-checked="@(RowFilter.HideOutputs ? "true" : "false")" data-testid="menu-rows-outputs">
                        Output Rows
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(RowFilter.HideSettings)"
                                 OnClick="() => viewSettings.SetRowFilterAsync(RowFilter with { HideSettings = !RowFilter.HideSettings })"
                                 title="Rows for role assignments, diagnostic settings, locks and other resources that configure the resource above them (Bicep)."
                                 data-checked="@(RowFilter.HideSettings ? "true" : "false")" data-testid="menu-rows-settings">
                        Setting Rows
                    </MudMenuItem>
                </MudMenu>

            </MudMenu>

            <ModelsMenu />

            <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Settings" OnClick="ShowSettingsAsync"
                         title="@SettingsTitle"
                         data-testid="menu-settings">
                Settings …
            </MudMenuItem>

            <MudDivider />

            <MudMenu Label="Help" PopoverClass="@MenuClass" data-testid="menu-help-group">
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Help" OnClick="ShowHelpAsync"
                             data-testid="menu-help">
                    Help
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.TipsAndUpdates" OnClick="coachService.Start"
                             title="Replays the short tour of the basics shown on the first start."
                             data-testid="menu-tips">
                    Show Tips
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Route" OnClick="tourService.Open"
                             title="An AI picks the key parts of this codebase, and the tour walks you through them."
                             data-testid="menu-tour">
                    Tour This Codebase …
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.NewReleases" OnClick="ShowWhatsNewAsync"
                             title="Opens the change log: what is new in each release, and what is coming in the next one."
                             data-testid="menu-whats-new">
                    What's New
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.BugReport"
                             OnClick="() => issueReportService.OpenAsync(IssueKind.Bug)"
                             title="Opens a new GitHub issue with the app version and environment filled in."
                             data-testid="menu-report-bug">
                    Report a Bug
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Lightbulb"
                             OnClick="() => issueReportService.OpenAsync(IssueKind.Improvement)"
                             title="Opens a new GitHub issue for an idea or improvement."
                             data-testid="menu-suggest-improvement">
                    Suggest an Improvement
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Info" OnClick="ShowAbout"
                             data-testid="menu-about">
                    About
                </MudMenuItem>

                @if (!Build.IsVsCodeExtWasm)
                {
                    <MudDivider />

                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Refresh"
                                 OnClick="ReloadPageAsync" data-testid="menu-reload">
                        Reload App
                    </MudMenuItem>
                }
            </MudMenu>
        </MudMenu>
    </MudTooltip>

    <CloudSyncButton />

    <MudTooltip Text="Search (Ctrl+F)">
        <MudIconButton Icon="@Icons.Material.Outlined.Search" OnClick="OpenSearchAsync" data-testid="toolbar-search" />
    </MudTooltip>

    <MudTooltip Text="Fit to Screen (Home)">
        <MudIconButton Icon="@Icons.Material.Outlined.FitScreen" OnClick="canvasService.PanZoomToFit"
                       data-testid="toolbar-fit" />
    </MudTooltip>

    @* View history: where the last jump (search, explorer, breadcrumb, fit) came from. *@
    <MudTooltip Text="@(viewHistory.CanGoBack ? "Back to the previous view (Alt+←, Backspace)" : "No previous view")">
        <span>
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Disabled="@(!viewHistory.CanGoBack)"
                           OnClick="viewHistory.GoBackAsync" data-testid="toolbar-back" />
        </span>
    </MudTooltip>
    <MudTooltip Text="@(viewHistory.CanGoForward ? "Forward again (Alt+→, Shift+Backspace)" : "No next view")">
        <span>
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowForward" Disabled="@(!viewHistory.CanGoForward)"
                           OnClick="viewHistory.GoForwardAsync" data-testid="toolbar-forward" />
        </span>
    </MudTooltip>

    @* A disabled button fires no pointer events, so the tooltip needs the wrapping span to
       keep working (and say why the button is off). *@
    <MudTooltip Text="@(commandService.CanUndo ? "Undo (Ctrl+Z)" : "Nothing to undo")">
        <span>
            <MudIconButton Icon="@Icons.Material.Outlined.Undo" Disabled="@(!commandService.CanUndo)"
                           OnClick="commandService.Undo" data-testid="toolbar-undo" />
        </span>
    </MudTooltip>

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTooltip Text="@(commandService.CanRedo ? "Redo (Ctrl+Y)" : "Nothing to redo")">
            <span>
                <MudIconButton Icon="@Icons.Material.Outlined.Redo" Disabled="@(!commandService.CanRedo)"
                               OnClick="commandService.Redo" data-testid="toolbar-redo" />
            </span>
        </MudTooltip>
        @if (CanParseCurrentModel)
        {
            <MudTooltip Text="@(modelService.HasSourceChanges ? "Source files changed, re-parse the solution" : "Re-parse the solution")">
                <MudBadge Dot="true" Color="Color.Warning" Overlap="true" Visible="modelService.HasSourceChanges"
                          data-testid="toolbar-parse-changed">
                    <MudIconButton Icon="@Icons.Material.Outlined.Autorenew" OnClick="canvasService.RefreshAsync"
                                   data-testid="toolbar-parse" />
                </MudBadge>
            </MudTooltip>
        }
    </MudHidden>

    @if (viewOptions.IsEditingEnabled)
    {
        <MudTooltip Text="Edit mode is on: click to switch to view mode">
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Edit" Color="@Color.Warning" OnClick="ToggleEditMode"
                           data-checked="true" data-testid="toolbar-edit" />
        </MudTooltip>
    }
    else
    {
        <MudTooltip Text="View mode: click to enable editing">
            <MudIconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Color="@Color.Tertiary"
                           OnClick="ToggleEditMode" data-checked="false" data-testid="toolbar-edit" />
        </MudTooltip>
    }

    @if (askModelService.IsAvailable)
    {
        <MudTooltip Text="Ask about the model">
            <MudIconButton Icon="@Icons.Material.Outlined.QuestionAnswer" OnClick="askModelService.Toggle"
                           Color="@(viewOptions.IsAskShown ? Color.Primary : Color.Tertiary)"
                           data-checked="@(viewOptions.IsAskShown ? "true" : "false")" data-testid="toolbar-ask" />
        </MudTooltip>
    }

    <ProblemIndicator OnShowCycles="panelService.ShowCycles" OnShowRules="panelService.ShowRules" />
    <HiddenNodesIndicator OnToggle="ToggleHiddenNodes" />

    @* Help is the last button, where it is easy to find; the indicators come and go before it. *@
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTooltip Text="Help">
            <MudIconButton Icon="@Icons.Material.Outlined.Help" OnClick="ShowHelpAsync" data-testid="toolbar-help" />
        </MudTooltip>
    </MudHidden>

</MudButtonGroup>

<MudMessageBox @ref="aboutBox" Title="About Dependinator" YesText="Close">
    <MessageContent>
        <MudText Typo="Typo.body1">Version: @Build.Version</MudText>
        @if (Build.VsCodeExtensionVersion != "")
        {
            <MudText Typo="Typo.body1">Extension version: @Build.VsCodeExtensionVersion</MudText>
        }
        <MudText Typo="Typo.body1">Commit sha: @Build.CommitSid</MudText>
        <MudText Typo="Typo.body1">Build Time: @Build.Time</MudText>
    </MessageContent>
</MudMessageBox>

@code {
    MudMessageBox aboutBox { get; set; } = null!;
    bool isSearchOpen;

    // The z-index keeps it above the canvas while a pan or zoom moves the canvas by a CSS
    // transform (GestureTransform), which paints it above fixed elements without one.
    string CssPosition => $"position:fixed;left:{15}px; top:{6}px; z-index:1100;";
    string MenuClass => themeService.IsDark ? "dep-dark-menu" : "dep-light-menu";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        applicationEvents.UIStateChanged += OnUiStateChanged;
        applicationEvents.SearchRequested += OnSearchRequested;
        themeService.Changed += OnUiStateChanged;
        keyboardService.KeyDown += OnKeyDown;
    }

    // The app-level shortcuts: search, undo/redo and fit. Canvas gestures (Escape, arrows,
    // zoom) are handled by the interaction service, Delete by the toolbars.
    void OnKeyDown(KeyPress key)
    {
        if (key.IsCtrl && (key.Is("f") || key.Is("t")))
            _ = InvokeAsync(OpenSearchAsync);
        else if (key.IsCtrl && key.Is("z"))
            _ = InvokeAsync(commandService.Undo);
        else if ((key.IsCtrl && key.Is("y")) || (key.IsCtrlShift && key.Is("z")))
            _ = InvokeAsync(commandService.Redo);
        else if ((key.IsPlain && key.Is("Home")) || (key.IsCtrl && key.Is("0")))
            _ = InvokeAsync(canvasService.PanZoomToFit);
        else if ((key.IsAlt && key.Is("ArrowLeft")) || (key.IsPlain && key.Is("Backspace")))
            _ = InvokeAsync(viewHistory.GoBackAsync);
        else if ((key.IsAlt && key.Is("ArrowRight")) || (key.IsShift && key.Is("Backspace")))
            _ = InvokeAsync(viewHistory.GoForwardAsync);
    }


    void OnSearchRequested() => _ = InvokeAsync(OpenSearchAsync);

    async Task OpenSearchAsync()
    {
        if (isSearchOpen)
            return;

        isSearchOpen = true;
        coachService.NoticeSearchOpened();
        try
        {
            var dialog = await dialogService.ShowAsync<Dependinator.UI.Diagrams.Navigation.SearchDialog>(
                (string?)null,
                Dependinator.UI.Diagrams.Navigation.SearchDialog.Options
            );
            await dialog.Result;
        }
        finally
        {
            isSearchOpen = false;
        }
    }

    public void Dispose()
    {
        applicationEvents.UIStateChanged -= OnUiStateChanged;
        applicationEvents.SearchRequested -= OnSearchRequested;
        themeService.Changed -= OnUiStateChanged;
        keyboardService.KeyDown -= OnKeyDown;
    }

    // The armed modes show their instructions in the ModeBanner until the click/drag lands.
    void BeginAddNote() => noteService.BeginPlaceNote();

    void BeginAddZone() => zoneService.BeginPlaceZone();

    void BeginAddNode() => manualEditService.BeginPlaceNode();

    void BeginExportArea() => exportService.ExportAreaAsync().RunInBackground();

    bool CanParseCurrentModel => ModelsMenu.CanParse(modelMgr.ModelPath);

    async Task ReloadPageAsync() => await jsInterop.Call("reloadPage");

    Task ShowAbout() => aboutBox.ShowAsync();

    Task ShowHelpAsync() => vsCodeSendService.OpenHelpAsync();

    // The change log on main, as of the latest release (the release workflow merges dev into main).
    const string ChangeLogUrl = "https://github.com/michael-reichenauer/Dependinator/blob/main/CHANGELOG.md";

    Task ShowWhatsNewAsync() => vsCodeSendService.OpenExternalAsync(ChangeLogUrl);

    void OnUiStateChanged() => _ = InvokeAsync(StateHasChanged);

    // Toggles read as checkboxes, so their on/off state is visible at a glance.
    static string CheckIcon(bool isOn) =>
        isOn ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank;

    static string RadioIcon(bool isOn) =>
        isOn ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.RadioButtonUnchecked;

    string RevealHiddenNodesIcon => CheckIcon(viewOptions.RevealHiddenNodes);
    string LegendIcon => CheckIcon(viewOptions.IsLegendShown);
    string MinimapIcon => CheckIcon(viewOptions.IsMinimapShown);

    string CyclesIcon => CheckIcon(viewOptions.IsCyclesShown);
    string RulesIcon => CheckIcon(viewOptions.IsRulesShown);
    string AskIcon => CheckIcon(viewOptions.IsAskShown);
    string HiddenNodesListIcon => CheckIcon(viewOptions.IsHiddenNodesShown);

    void ToggleHiddenNodes() => hiddenNodeService.TogglePanel();

    static readonly (int Count, string Label)[] MinLinkChoices =
    [
        (1, "Any number of links"),
        (2, "2 or more links"),
        (5, "5 or more links"),
        (10, "10 or more links"),
    ];

    LineFilter LineFilter => viewOptions.LineFilter;

    // The submenu label says when a filter is active, since the diagram then hides lines.
    string LinesMenuLabel => LineFilter.IsAny ? "Lines (filtered)" : "Lines";

    RowFilter RowFilter => viewOptions.RowFilter;
    string RowsMenuLabel => RowFilter.IsAny ? "Rows (filtered)" : "Rows";

    string EditModeIcon => CheckIcon(viewOptions.IsEditingEnabled);
    string NotesSidebarIcon => CheckIcon(noteService.IsShowSidebar);

    Task ToggleEditMode() => viewSettings.SetEditingAsync(!viewOptions.IsEditingEnabled);

    Task ShowSettingsAsync() => SettingsDialog.ShowAsync(dialogService);

    static string SettingsTitle =>
        Build.IsVsCodeExtWasm
            ? "Theme, layout density, badges, mouse zoom, this model's test projects, the AI, following the editor and refreshing."
            : "Theme, layout density, badges, mouse zoom, this model's test projects and the AI.";

}
