@using Dependinator.Core
@using Dependinator.Core.Shared
@using Dependinator.UI.Modeling
@using Dependinator.UI.Modeling.Commands
@using Dependinator.UI.Shared.CloudSync

@inject ICanvasService canvasService
@inject IAppCloudSyncService appCloudSyncService
@inject ISnackbar snackbar
@inject Dependinator.UI.Modeling.Models.IModelMgr modelMgr
@inject ICommandService commandService
@inject IApplicationEvents applicationEvents
@inject IModelListService modelListService
@inject IConfigService configService
@inject IModelService modelService
@inject IDialogService dialogService
@inject IJSInterop jsInterop
@inject IVsCodeSendService vsCodeSendService
@inject Dependinator.UI.Diagrams.Interaction.INoteService noteService
@inject Dependinator.UI.Diagrams.Interaction.IManualEditService manualEditService
@inject Dependinator.UI.Diagrams.Export.IExportService exportService
@inject Dependinator.UI.Diagrams.ILineSplitService lineSplitService
@inject IPointerEventService pointerEventService
@inject Dependinator.UI.Diagrams.IViewOptions viewOptions
@inject Dependinator.UI.Diagrams.IPathFinderService pathFinderService
@inject Dependinator.UI.Diagrams.ICoachService coachService
@inject IShareLinkService shareLinkService
@inject IThemeService themeService
@inject IKeyboardService keyboardService
@inject Dependinator.UI.Diagrams.Interaction.IViewHistoryService viewHistory
@implements IDisposable

<MudButtonGroup Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Text" Class="dep-toolbar-card"
                Style="@CssPosition">
    <MudTooltip Text="Menu">
        <MudMenu Icon="@Icons.Material.Outlined.Menu" IconColor="Color.Tertiary" Dense="true"
                 AnchorOrigin="Origin.BottomCenter" PopoverClass="@MenuClass" data-testid="appbar-menu">
            <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Search" OnClick="OpenSearchAsync"
                         data-testid="menu-search">
                Search …
            </MudMenuItem>

            <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.FitScreen"
                         OnClick="canvasService.PanZoomToFit" data-testid="menu-fit-to-screen">
                Fit to Screen
            </MudMenuItem>

            <MudDivider />

            <MudMenu Label="Edit" PopoverClass="@MenuClass" data-testid="menu-edit">
                <MudMenuItem IconColor="Color.Secondary" Icon="@EditModeIcon" OnClick="ToggleEditMode"
                             title="Move, resize, link, color and add nodes. Off: the diagram is view-only."
                             data-checked="@(viewOptions.IsEditingEnabled ? "true" : "false")"
                             data-testid="menu-edit-mode">
                    Edit Mode
                </MudMenuItem>

                <MudDivider />

                <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">History</MudText>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Undo"
                             Disabled="@(!commandService.CanUndo)" OnClick="commandService.Undo" data-testid="menu-undo">
                    Undo
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Redo"
                             Disabled="@(!commandService.CanRedo)" OnClick="commandService.Redo" data-testid="menu-redo">
                    Redo
                </MudMenuItem>

                @if (viewOptions.IsEditingEnabled)
                {
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Insert</MudText>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.AddBox" OnClick="BeginAddNode"
                                 data-testid="menu-add-node">
                        Add Node …
                    </MudMenuItem>

                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.StickyNote2"
                                 OnClick="BeginAddNote" data-testid="menu-add-note">
                        Add Note …
                    </MudMenuItem>
                }
            </MudMenu>

            <MudMenu Label="Export" PopoverClass="@MenuClass" data-testid="menu-export">
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.HighlightAlt"
                             OnClick="BeginExportArea" data-testid="menu-export-area">
                    Select Area …
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Screenshot"
                             OnClick="exportService.ExportCurrentViewAsync" data-testid="menu-export-view">
                    Current View …
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Image"
                             OnClick="exportService.ExportEntireDiagramAsync" data-testid="menu-export-diagram">
                    Entire Diagram …
                </MudMenuItem>

                <MudDivider />

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Link"
                             OnClick="shareLinkService.CopyViewLinkAsync"
                             title="Copies a dependinator.com link that opens this model at the current view."
                             data-testid="menu-copy-view-link">
                    Link to Current View
                </MudMenuItem>
            </MudMenu>

            <MudMenu Label="View" PopoverClass="@MenuClass" data-testid="menu-view">
                <MudMenuItem IconColor="Color.Secondary" Icon="@ShowHiddenNodesIcon" OnClick="ToggleShowHiddenNodes"
                             data-checked="@(viewOptions.ShowHiddenNodes ? "true" : "false")"
                             data-testid="menu-show-hidden-nodes">
                    Show Hidden Nodes
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@NotesSidebarIcon" OnClick="noteService.ToggleSidebar"
                             data-checked="@(noteService.IsShowSidebar ? "true" : "false")"
                             data-testid="menu-notes-sidebar">
                    Show Notes Sidebar
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@LegendIcon" OnClick="ToggleLegend"
                             data-checked="@(viewOptions.IsLegendShown ? "true" : "false")"
                             data-testid="menu-legend">
                    Show Legend
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@CyclesIcon" OnClick="ToggleCycles"
                             title="Lists circular dependencies and draws their lines in red."
                             data-checked="@(viewOptions.IsCyclesShown ? "true" : "false")"
                             data-testid="menu-cycles">
                    Show Cycles
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.AltRoute" OnClick="pathFinderService.Open"
                             title="Shows why one node depends on another: the shortest chain of dependencies between two nodes you choose."
                             data-testid="menu-find-path">
                    Find Path …
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@DimUnrelatedLinesIcon" OnClick="ToggleDimUnrelatedLines"
                             title="While a node or line is selected, fade every line that does not touch it."
                             data-checked="@(viewOptions.DimUnrelatedLines ? "true" : "false")"
                             data-testid="menu-dim-unrelated-lines">
                    Dim Unrelated Lines
                </MudMenuItem>

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.UnfoldLess"
                             OnClick="lineSplitService.ClearAll" data-testid="menu-hide-direct-lines">
                    Hide All Direct Lines
                </MudMenuItem>

                <MudMenu Label="@LinesMenuLabel" StartIcon="@Icons.Material.Outlined.FilterAlt" IconColor="Color.Secondary"
                         Dense="true" PopoverClass="@MenuClass" data-testid="menu-lines">
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Leave out</MudText>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideExternal)"
                                 OnClick="() => SetLineFilterAsync(LineFilter with { HideExternal = !LineFilter.HideExternal })"
                                 title="Lines to or from external packages and framework assemblies."
                                 data-checked="@(LineFilter.HideExternal ? "true" : "false")" data-testid="menu-lines-external">
                        Lines to Externals
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideInheritance)"
                                 OnClick="() => SetLineFilterAsync(LineFilter with { HideInheritance = !LineFilter.HideInheritance })"
                                 title="Base class and interface implementation lines (hollow arrow heads)."
                                 data-checked="@(LineFilter.HideInheritance ? "true" : "false")" data-testid="menu-lines-inheritance">
                        Inheritance Lines
                    </MudMenuItem>
                    <MudMenuItem IconColor="Color.Secondary" Icon="@CheckIcon(LineFilter.HideMember)"
                                 OnClick="() => SetLineFilterAsync(LineFilter with { HideMember = !LineFilter.HideMember })"
                                 title="Lines that start or end at a method, property, field or event."
                                 data-checked="@(LineFilter.HideMember ? "true" : "false")" data-testid="menu-lines-member">
                        Member Lines
                    </MudMenuItem>

                    <MudDivider />
                    <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Show lines with</MudText>
                    @foreach (var (count, label) in MinLinkChoices)
                    {
                        <MudMenuItem IconColor="Color.Secondary" Icon="@RadioIcon(LineFilter.MinLinkCount == count)"
                                     OnClick="() => SetLineFilterAsync(LineFilter with { MinLinkCount = count })"
                                     data-checked="@(LineFilter.MinLinkCount == count ? "true" : "false")"
                                     data-testid="@($"menu-lines-min-{count}")">
                            @label
                        </MudMenuItem>
                    }
                </MudMenu>

                <MudDivider />

                <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Theme</MudText>
                <MudMenuItem IconColor="Color.Secondary" Icon="@ThemeIcon(AppTheme.System)"
                             OnClick="() => SetThemeAsync(AppTheme.System)"
                             title="Follows the system (or, in VS Code, the editor) color theme."
                             data-checked="@(themeService.Theme == AppTheme.System ? "true" : "false")"
                             data-testid="menu-theme-system">
                    System
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@ThemeIcon(AppTheme.Light)"
                             OnClick="() => SetThemeAsync(AppTheme.Light)"
                             data-checked="@(themeService.Theme == AppTheme.Light ? "true" : "false")"
                             data-testid="menu-theme-light">
                    Light
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@ThemeIcon(AppTheme.Dark)"
                             OnClick="() => SetThemeAsync(AppTheme.Dark)"
                             data-checked="@(themeService.Theme == AppTheme.Dark ? "true" : "false")"
                             data-testid="menu-theme-dark">
                    Dark
                </MudMenuItem>
            </MudMenu>

            <MudMenu Label="Models" PopoverClass="@MenuClass" data-testid="menu-models">
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.ViewList" OnClick="ManageModelsAsync"
                             data-testid="menu-manage-models">
                    Manage Models …
                </MudMenuItem>

                <MudDivider />

                <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Models</MudText>
                @{
                    IReadOnlyList<ModelItem> modelItems = modelListService.GetModelItems();
                }
                @foreach (ModelItem item in modelItems)
                {
                    bool isCurrent = IsCurrentModel(item);
                    <MudMenuItem IconColor="@GetMenuItemIconColor(isCurrent)" Icon="@GetModelItemIcon(item)"
                                 Style="@GetCurrentItemStyle(isCurrent)" title="@GetModelItemTitle(item)"
                                 OnClick="() => LoadModelItemAsync(item)" data-testid="menu-model-item">
                        @item.DisplayName
                    </MudMenuItem>
                }
                @if (modelItems.Count == 0)
                {
                    <MudMenuItem Disabled="true">No models</MudMenuItem>
                }

                <MudDivider />

                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.AddBox" OnClick="NewModelAsync"
                             data-testid="menu-new-model">
                    New Model …
                </MudMenuItem>

                @if (CanParseCurrentModel)
                {
                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Autorenew"
                                 OnClick="canvasService.RefreshAsync" data-testid="menu-parse">
                        Parse
                    </MudMenuItem>
                }

                <MudMenuItem IconColor="Color.Error" Icon="@Icons.Material.Outlined.DeveloperBoardOff"
                             OnClick="OnDeleteModelAsync" data-testid="menu-delete-model">
                    Delete Current Model
                </MudMenuItem>
            </MudMenu>

            <MudMenu Label="Settings" PopoverClass="@MenuClass" data-testid="menu-settings">
                <MudMenuItem IconColor="Color.Secondary" Icon="@IncludeTestProjectsIcon"
                             Disabled="@(!CanParseCurrentModel)"
                             title="Re-parses the solution. Test projects are excluded by default."
                             data-checked="@(IncludeTestProjects ? "true" : "false")"
                             OnClick="ToggleIncludeTestProjectsAsync" data-testid="menu-include-test-projects">
                    Include Test Projects
                </MudMenuItem>

                <MudDivider />

                <MudMenuItem IconColor="Color.Secondary" Icon="@InvertScrollZoomIcon" OnClick="ToggleInvertScrollZoom"
                             title="Flips the mouse wheel zoom direction, e.g. for natural scrolling on macOS."
                             data-checked="@(pointerEventService.InvertScrollZoom ? "true" : "false")"
                             data-testid="menu-invert-scroll-zoom">
                    Invert Scroll Zoom
                </MudMenuItem>
            </MudMenu>

            <MudDivider />

            <MudMenu Label="Help" PopoverClass="@MenuClass" data-testid="menu-help-group">
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Help" OnClick="ShowHelpAsync"
                             data-testid="menu-help">
                    Help
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.TipsAndUpdates" OnClick="coachService.Start"
                             title="Replays the short tour of the basics shown on the first start."
                             data-testid="menu-tips">
                    Show Tips
                </MudMenuItem>
                <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Info" OnClick="ShowAbout"
                             data-testid="menu-about">
                    About
                </MudMenuItem>

                @if (!Build.IsVsCodeExtWasm)
                {
                    <MudDivider />

                    <MudMenuItem IconColor="Color.Secondary" Icon="@Icons.Material.Outlined.Refresh"
                                 OnClick="ReloadPageAsync" data-testid="menu-reload">
                        Reload App
                    </MudMenuItem>
                }
            </MudMenu>
        </MudMenu>
    </MudTooltip>

    <CloudSyncButton />

    <MudTooltip Text="Search (Ctrl+F)">
        <MudIconButton Icon="@Icons.Material.Outlined.Search" OnClick="OpenSearchAsync" data-testid="toolbar-search" />
    </MudTooltip>

    <MudTooltip Text="Fit to Screen (Home)">
        <MudIconButton Icon="@Icons.Material.Outlined.FitScreen" OnClick="canvasService.PanZoomToFit"
                       data-testid="toolbar-fit" />
    </MudTooltip>

    @* View history: where the last jump (search, explorer, breadcrumb, fit) came from. *@
    <MudTooltip Text="@(viewHistory.CanGoBack ? "Back to the previous view (Alt+←, Backspace)" : "No previous view")">
        <span>
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Disabled="@(!viewHistory.CanGoBack)"
                           OnClick="viewHistory.GoBackAsync" data-testid="toolbar-back" />
        </span>
    </MudTooltip>
    <MudTooltip Text="@(viewHistory.CanGoForward ? "Forward again (Alt+→, Shift+Backspace)" : "No next view")">
        <span>
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowForward" Disabled="@(!viewHistory.CanGoForward)"
                           OnClick="viewHistory.GoForwardAsync" data-testid="toolbar-forward" />
        </span>
    </MudTooltip>

    @* A disabled button fires no pointer events, so the tooltip needs the wrapping span to
       keep working (and say why the button is off). *@
    <MudTooltip Text="@(commandService.CanUndo ? "Undo (Ctrl+Z)" : "Nothing to undo")">
        <span>
            <MudIconButton Icon="@Icons.Material.Outlined.Undo" Disabled="@(!commandService.CanUndo)"
                           OnClick="commandService.Undo" data-testid="toolbar-undo" />
        </span>
    </MudTooltip>

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTooltip Text="@(commandService.CanRedo ? "Redo (Ctrl+Y)" : "Nothing to redo")">
            <span>
                <MudIconButton Icon="@Icons.Material.Outlined.Redo" Disabled="@(!commandService.CanRedo)"
                               OnClick="commandService.Redo" data-testid="toolbar-redo" />
            </span>
        </MudTooltip>
        @if (CanParseCurrentModel)
        {
            <MudTooltip Text="Re-parse the solution">
                <MudIconButton Icon="@Icons.Material.Outlined.Autorenew" OnClick="canvasService.RefreshAsync"
                               data-testid="toolbar-parse" />
            </MudTooltip>
        }
    </MudHidden>

    @if (viewOptions.IsEditingEnabled)
    {
        <MudTooltip Text="Edit mode is on: click to switch to view mode">
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Edit" Color="@Color.Warning" OnClick="ToggleEditMode"
                           data-checked="true" data-testid="toolbar-edit" />
        </MudTooltip>
    }
    else
    {
        <MudTooltip Text="View mode: click to enable editing">
            <MudIconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Color="@Color.Tertiary"
                           OnClick="ToggleEditMode" data-checked="false" data-testid="toolbar-edit" />
        </MudTooltip>
    }

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTooltip Text="Help">
            <MudIconButton Icon="@Icons.Material.Outlined.Help" OnClick="ShowHelpAsync" data-testid="toolbar-help" />
        </MudTooltip>
    </MudHidden>

</MudButtonGroup>

<MudMessageBox @ref="deleteLocalModelBox" Title="Delete Current Model" CancelText="Cancel">
    <MessageContent>
        <MudText>Do you want to delete the current model?</MudText>
        <MudText Typo="Typo.body2">Note: Layout of all nodes and sub-nodes will be deleted.</MudText>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeveloperBoardOff">
            Delete
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudMessageBox @ref="deleteLocalOrRemoteModelBox" Title="Delete Current Model" CancelText="Cancel">
    <MessageContent>
        <MudText>Do you want to delete only the local model, or both the local and the remote (cloud) model?</MudText>
        <MudText Typo="Typo.body2">Note: Layout of all nodes and sub-nodes will be deleted.</MudText>
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error">
            Local Only
        </MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeveloperBoardOff">
            Local and Remote
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudMessageBox @ref="aboutBox" Title="About Dependinator" YesText="Close">
    <MessageContent>
        <MudText Typo="Typo.body1">Version: @Build.Version</MudText>
        @if (Build.VsCodeExtensionVersion != "")
        {
            <MudText Typo="Typo.body1">Extension version: @Build.VsCodeExtensionVersion</MudText>
        }
        <MudText Typo="Typo.body1">Commit sha: @Build.CommitSid</MudText>
        <MudText Typo="Typo.body1">Build Time: @Build.Time</MudText>
    </MessageContent>
</MudMessageBox>

@code {
    MudMessageBox deleteLocalModelBox { get; set; } = null!;
    MudMessageBox deleteLocalOrRemoteModelBox { get; set; } = null!;
    MudMessageBox aboutBox { get; set; } = null!;

    bool isSearchOpen;

    string? CurrentRecentModelPath =>
    modelListService.RecentModelPaths.Count > 0 ? modelListService.RecentModelPaths[0] : null;
    string? CurrentCloudModelPath => appCloudSyncService.CurrentNormalizedModelPath;
    global::Shared.CloudAuthState AuthState => appCloudSyncService.AuthState;
    string CssPosition => $"position:fixed;left:{15}px; top:{3}px;";
    string MenuClass => themeService.IsDark ? "dep-dark-menu" : "dep-light-menu";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        applicationEvents.UIStateChanged += OnUiStateChanged;
        applicationEvents.ErrorReported += OnErrorReported;
        applicationEvents.InfoReported += OnInfoReported;
        applicationEvents.SearchRequested += OnSearchRequested;
        appCloudSyncService.Changed += OnUiStateChanged;
        themeService.Changed += OnUiStateChanged;
        keyboardService.KeyDown += OnKeyDown;
    }

    // The app-level shortcuts: search, undo/redo and fit. Canvas gestures (Escape, arrows,
    // zoom) are handled by the interaction service, Delete by the toolbars.
    void OnKeyDown(KeyPress key)
    {
        if (key.IsCtrl && (key.Is("f") || key.Is("t")))
            _ = InvokeAsync(OpenSearchAsync);
        else if (key.IsCtrl && key.Is("z"))
            _ = InvokeAsync(commandService.Undo);
        else if ((key.IsCtrl && key.Is("y")) || (key.IsCtrlShift && key.Is("z")))
            _ = InvokeAsync(commandService.Redo);
        else if ((key.IsPlain && key.Is("Home")) || (key.IsCtrl && key.Is("0")))
            _ = InvokeAsync(canvasService.PanZoomToFit);
        else if ((key.IsAlt && key.Is("ArrowLeft")) || (key.IsPlain && key.Is("Backspace")))
            _ = InvokeAsync(viewHistory.GoBackAsync);
        else if ((key.IsAlt && key.Is("ArrowRight")) || (key.IsShift && key.Is("Backspace")))
            _ = InvokeAsync(viewHistory.GoForwardAsync);
    }

    // Errors can be reported from background work (e.g. a refresh parse), so marshal to the
    // renderer. RequireInteraction keeps the message up until dismissed, since a failed parse
    // otherwise just looks like an empty diagram. A report can carry an action (retry, include
    // test projects), shown as the snackbar's button.
    void OnErrorReported(ErrorReport report)
    {
        _ = InvokeAsync(() =>
            snackbar.Add(
                report.Message,
                Severity.Error,
                config =>
                {
                    config.RequireInteraction = true;
                    if (report.Action is { } action)
                    {
                        config.Action = action.Label;
                        config.ActionColor = Color.Inherit;
                        config.OnClick = _ => RunErrorActionAsync(action);
                    }
                }
            )
        );
    }

    async Task RunErrorActionAsync(ErrorAction action)
    {
        switch (action.Kind)
        {
            case ErrorActionKind.RetryLoad when action.Path is { } path:
                await canvasService.LoadAsync(path);
                break;
            case ErrorActionKind.RetryRefresh:
                await canvasService.RefreshAsync();
                break;
            case ErrorActionKind.IncludeTestProjects:
                await modelService.SetIncludeTestProjectsAsync(true);
                break;
        }
    }

    void OnSearchRequested() => _ = InvokeAsync(OpenSearchAsync);

    // E.g. what a background refresh changed: worth a note, not an interruption.
    void OnInfoReported(string message)
    {
        _ = InvokeAsync(() => snackbar.Add(message, Severity.Info));
    }

    async Task OpenSearchAsync()
    {
        if (isSearchOpen)
            return;

        isSearchOpen = true;
        coachService.NoticeSearchOpened();
        try
        {
            var dialog = await dialogService.ShowAsync<Dependinator.UI.Diagrams.SearchDialog>(
                (string?)null,
                Dependinator.UI.Diagrams.SearchDialog.Options
            );
            await dialog.Result;
        }
        finally
        {
            isSearchOpen = false;
        }
    }

    public void Dispose()
    {
        applicationEvents.UIStateChanged -= OnUiStateChanged;
        applicationEvents.ErrorReported -= OnErrorReported;
        applicationEvents.InfoReported -= OnInfoReported;
        applicationEvents.SearchRequested -= OnSearchRequested;
        appCloudSyncService.Changed -= OnUiStateChanged;
        themeService.Changed -= OnUiStateChanged;
        keyboardService.KeyDown -= OnKeyDown;
    }

    async Task LoadCloudModelAsync(global::Shared.CloudModelMetadata cloudModel)
    {
        if (await appCloudSyncService.LoadCloudModelAsync(cloudModel) is Error error)
        {
            snackbar.Add(error.Message, Severity.Error);
            return;
        }

        snackbar.Add(
        $"Loaded cloud model for {Path.GetFileNameWithoutExtension(cloudModel.NormalizedPath)}.",
        Severity.Success
        );
    }

    bool HasRemoteCopyOfCurrentModel =>
    AuthState.IsAuthenticated
    && CurrentCloudModelPath is string currentModelPath
    && appCloudSyncService.CloudModels.Any(cloudModel =>
    string.Equals(cloudModel.NormalizedPath, currentModelPath, StringComparison.OrdinalIgnoreCase)
    );

    async Task OnDeleteModelAsync()
    {
        if (!HasRemoteCopyOfCurrentModel)
        {
            if (await deleteLocalModelBox.ShowAsync() != true)
                return;

            await canvasService.RemoveAsync();
            return;
        }

        // Yes = delete local and remote, No = delete local only, null = cancel.
        bool? choice = await deleteLocalOrRemoteModelBox.ShowAsync();
        if (choice is null)
            return;

        if (choice is true && await appCloudSyncService.DeleteCurrentCloudModelAsync() is Error error)
        {
            snackbar.Add(error.Message, Severity.Error);
            return;
        }

        await canvasService.RemoveAsync();
    }

    // The armed modes show their instructions in the ModeBanner until the click/drag lands.
    void BeginAddNote() => noteService.BeginPlaceNote();

    void BeginAddNode() => manualEditService.BeginPlaceNode();

    void BeginExportArea() => exportService.ExportAreaAsync().RunInBackground();

    bool CanParseCurrentModel =>
    (Build.IsVsCodeExtWasm || Build.IsWeb) && ModelPaths.IsParseable(modelMgr.ModelPath);

    async Task ManageModelsAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await dialogService.ShowAsync<ModelsDialog>((string?)null, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: "new" })
            await NewModelAsync();
    }

    async Task NewModelAsync()
    {
        List<string> existingPaths = modelListService.GetModelItems().Select(item => item.Path).ToList();
        var parameters = new DialogParameters<NewModelDialog> { { d => d.ExistingPaths, existingPaths } };
        var dialog = await dialogService.ShowAsync<NewModelDialog>("New Model", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
            return;

        string name = (string)result.Data!;

        // A new empty model is only useful with editing enabled; opening an existing
        // design model later leaves the toggle as the user last set it.
        await SetEditModeAsync(true);
        await canvasService.LoadAsync(name);
        snackbar.Add("Empty model created. Use Edit > Add Node or double-click the canvas to add nodes.",
        Severity.Info);
        applicationEvents.TriggerUIStateChanged();
    }

    async Task ReloadPageAsync() => await jsInterop.Call("reloadPage");

    Task ShowAbout() => aboutBox.ShowAsync();

    Task ShowHelpAsync() => vsCodeSendService.OpenHelpAsync();

    void OnUiStateChanged() => _ = InvokeAsync(StateHasChanged);

    // Toggles read as checkboxes, so their on/off state is visible at a glance.
    static string CheckIcon(bool isOn) =>
        isOn ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank;

    static string RadioIcon(bool isOn) =>
        isOn ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.RadioButtonUnchecked;

    string ShowHiddenNodesIcon => CheckIcon(viewOptions.ShowHiddenNodes);
    string DimUnrelatedLinesIcon => CheckIcon(viewOptions.DimUnrelatedLines);
    string LegendIcon => CheckIcon(viewOptions.IsLegendShown);
    string CyclesIcon => CheckIcon(viewOptions.IsCyclesShown);

    void ToggleCycles()
    {
        if (!viewOptions.IsCyclesShown)
            pathFinderService.Close(); // Both panels sit top-right and both recolor lines
        viewOptions.SetCyclesShown(!viewOptions.IsCyclesShown);
        modelService.ClearCache(); // Cyclic lines are drawn differently, baked into the tiles
        applicationEvents.TriggerUIStateChanged();
    }

    void ToggleLegend()
    {
        viewOptions.SetLegendShown(!viewOptions.IsLegendShown);
        applicationEvents.TriggerUIStateChanged();
    }

    static readonly (int Count, string Label)[] MinLinkChoices =
    [
        (1, "Any number of links"),
        (2, "2 or more links"),
        (5, "5 or more links"),
        (10, "10 or more links"),
    ];

    LineFilter LineFilter => viewOptions.LineFilter;

    // The submenu label says when a filter is active, since the diagram then hides lines.
    string LinesMenuLabel => LineFilter.IsAny ? "Lines (filtered)" : "Lines";

    async Task SetLineFilterAsync(LineFilter filter)
    {
        viewOptions.SetLineFilter(filter);
        await configService.SetAsync(config =>
        {
            config.HideExternalLines = filter.HideExternal;
            config.HideInheritanceLines = filter.HideInheritance;
            config.HideMemberLines = filter.HideMember;
            config.MinLinkCount = filter.MinLinkCount;
        });
        modelService.ClearCache(); // Which lines a tile holds depends on the filter
        applicationEvents.TriggerUIStateChanged();
    }
    string EditModeIcon => CheckIcon(viewOptions.IsEditingEnabled);
    string NotesSidebarIcon => CheckIcon(noteService.IsShowSidebar);
    string InvertScrollZoomIcon => CheckIcon(pointerEventService.InvertScrollZoom);
    string ThemeIcon(AppTheme theme) => RadioIcon(themeService.Theme == theme);

    bool IncludeTestProjects => modelMgr.WithModel(m => m.IncludeTestProjects);
    string IncludeTestProjectsIcon => CheckIcon(IncludeTestProjects);

    Task SetThemeAsync(AppTheme theme) => themeService.SetThemeAsync(theme);

    Task ToggleEditMode() => SetEditModeAsync(!viewOptions.IsEditingEnabled);

    async Task SetEditModeAsync(bool isEnabled)
    {
        viewOptions.SetIsEditingEnabled(isEnabled);
        await configService.SetAsync(config => config.IsEditingEnabled = isEnabled);
        // Edit-only markup (e.g. link handles) is baked into cached tiles, so the cache must be
        // cleared for the toggle to take effect immediately.
        modelService.ClearCache();
        applicationEvents.TriggerUIStateChanged();
    }

    async Task ToggleDimUnrelatedLines()
    {
        var newValue = !viewOptions.DimUnrelatedLines;
        viewOptions.SetDimUnrelatedLines(newValue);
        await configService.SetAsync(config => config.DimUnrelatedLines = newValue);
        modelService.ClearCache(); // Dimming is baked into the cached tiles
        applicationEvents.TriggerUIStateChanged();
    }

    async Task ToggleShowHiddenNodes()
    {
        var newValue = !viewOptions.ShowHiddenNodes;
        viewOptions.SetShowHiddenNodes(newValue);
        await configService.SetAsync(config => config.ShowHiddenNodes = newValue);
        modelService.ClearCache();
        applicationEvents.TriggerUIStateChanged();
    }

    async Task ToggleInvertScrollZoom()
    {
        var newValue = !pointerEventService.InvertScrollZoom;
        pointerEventService.InvertScrollZoom = newValue;
        await configService.SetAsync(config => config.InvertScrollZoom = newValue);
        applicationEvents.TriggerUIStateChanged();
    }

    async Task ToggleIncludeTestProjectsAsync()
    {
        var newValue = !IncludeTestProjects;
        // The refresh path only shows discreet progress, so say what is happening.
        snackbar.Add(
            newValue ? "Parsing with test projects ..." : "Parsing without test projects ...",
            Severity.Info
        );

        // A failed re-parse is reported centrally (ErrorReported), so the result is ignored here.
        await modelService.SetIncludeTestProjectsAsync(newValue);
    }

    static MudBlazor.Color GetMenuItemIconColor(bool isCurrent) => isCurrent ? Color.Secondary : Color.Default;

    static string? GetCurrentItemStyle(bool isCurrent) => isCurrent ? "color: var(--mud-palette-primary);" : null;

    static string GetModelItemIcon(ModelItem item) =>
    item switch
    {
        { IsLocal: true, IsCloud: true } => Icons.Material.Outlined.CloudDone,
        { IsCloud: true } => Icons.Material.Outlined.CloudDownload,
        _ when ModelPaths.IsDesignModel(item.Path) => Icons.Material.Outlined.DesignServices,
        _ => Icons.Material.Outlined.Schema,
    };

    static string GetModelItemTitle(ModelItem item)
    {
        string source = item switch
        {
            { IsLocal: true, IsCloud: true } => "Local + cloud",
            { IsCloud: true } => "Cloud",
            _ when ModelPaths.IsDesignModel(item.Path) => "Design",
            _ => "Local",
        };
        return $"{item.Path} ({source})";
    }

    async Task LoadModelItemAsync(ModelItem item)
    {
        if (item.IsLocal)
        {
            await canvasService.LoadAsync(item.Path);
            return;
        }

        await LoadCloudModelAsync(item.CloudModel!);
    }

    bool IsCurrentModel(ModelItem item) =>
    string.Equals(item.Path, CurrentRecentModelPath, StringComparison.Ordinal)
    || (
    item.IsCloud
    && string.Equals(
    item.CloudModel!.NormalizedPath,
    CurrentCloudModelPath,
    StringComparison.OrdinalIgnoreCase
    )
    );
}