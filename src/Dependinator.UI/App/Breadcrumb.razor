@using Dependinator.Core.Shared
@using Dependinator.UI.Diagrams
@inject IApplicationEvents applicationEvents
@inject IViewContextService viewContext
@inject Dependinator.UI.Diagrams.Interaction.ISelectionService selectionService
@inject Modeling.Models.IModelMgr modelMgr
@inject INavigationService navigationService
@inject ICanvasService canvasService
@implements IDisposable

@* Wayfinding bar under the app bar, shown only while a node is selected: the open model, then
   the chain of containers down to the selected node (just the model for a top-level node such
   as the solution, which the model crumb already names). Every crumb pans and zooms to that node;
   the model crumb fits the whole diagram. With nothing selected it is hidden, to keep the
   diagram clear (the "you are here" chain under the viewport center still drives Escape and
   the context menu, see ViewContextService). *@
@if (ModelName.Length > 0 && selectionService.SelectedId.IsNode)
{
  var chain = viewContext.GetSelectedChain();
  <nav class="dep-breadcrumb dep-toolbar-card" aria-label="Location" data-testid="breadcrumb">
    <button type="button" class="dep-breadcrumb__item dep-breadcrumb__model" @onclick="FitToScreen"
            title="@ModelTitle" data-testid="breadcrumb-model">
      <MudIcon Icon="@ModelIcon" Size="Size.Small" Class="dep-breadcrumb__icon" />
      <span>@ModelName</span>
    </button>
    @foreach (var item in chain)
    {
      <span class="dep-breadcrumb__sep">›</span>
      <button type="button" class="dep-breadcrumb__item" @onclick="() => ShowNodeAsync(item.Id)" title="@item.LongName"
              data-testid="breadcrumb-item">
        @item.Name
      </button>
    }
  </nav>
}

@code {
  string ModelPath => modelMgr.ModelPath;
  bool IsDesignModel => ModelPaths.IsDesignModel(ModelPath);

  string ModelName => string.IsNullOrEmpty(ModelPath) ? "" : (IsDesignModel ? ModelPath : Path.GetFileName(ModelPath));

  string ModelTitle => $"{ModelPath} ({ModelPaths.KindName(ModelPath)}). Click to fit to screen.";

  string ModelIcon => IsDesignModel ? MudBlazor.Icons.Material.Outlined.DesignServices : MudBlazor.Icons.Material.Outlined.Schema;

  protected override void OnInitialized() => applicationEvents.UIStateChanged += OnUiStateChanged;

  void OnUiStateChanged() => InvokeAsync(StateHasChanged);

  void FitToScreen() => canvasService.PanZoomToFit();

  Task ShowNodeAsync(Modeling.Models.NodeId nodeId) => navigationService.ShowNodeAsync(nodeId);

  public void Dispose() => applicationEvents.UIStateChanged -= OnUiStateChanged;
}
